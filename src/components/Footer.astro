---
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-col brand-col">
      <a class="footer-brand" href="/" aria-label="KarbonFiyat ana sayfa">
        <img src="/tulip-logo.png" alt="KarbonFiyat Logo" class="footer-logo-img" width="24" height="34" />
        <span>karbonfiyat</span>
      </a>
      <p class="brand-desc">Karbon fiyatını finansal karara çeviren bağımsız karar katmanı.</p>
    </div>

    <div class="footer-col">
      <strong class="col-title">Veri</strong>
      <nav class="col-links" aria-label="Veri linkleri">
        <a href="/karbon-fiyati">Karbon Fiyatı</a>
        <a href="/cbam-fiyati">CBAM</a>
        <a href="/turkiye-ets">Türkiye ETS</a>
      </nav>
    </div>

    <div class="footer-col">
      <strong class="col-title">Araçlar</strong>
      <nav class="col-links" aria-label="Araç linkleri">
        <a href="/karbon-maliyet-hesaplama">Maliyeti Hesapla</a>
        <a href="https://degerlet.com" rel="noopener">Uzman Değerlendirme</a>
      </nav>
    </div>

    <div class="footer-col">
      <strong class="col-title">Metodoloji</strong>
      <nav class="col-links" aria-label="Metodoloji linkleri">
        <a href="/metodoloji">Metodoloji İlkeleri</a>
        <a href="/metodoloji">Audit &amp; Versiyonlama</a>
      </nav>
    </div>
  </div>

  <div class="container footer-bottom">
    <span class="sub-notice">Piyasa, resmî ve senaryo verileri ayrı statülerde sunulur.</span>
    <span class="sub-copy mono">© {year} KarbonFiyat · Carbon Financial Intelligence</span>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border-soft);
    margin-top: 120px;
    padding: 64px 0 32px;
    background: #060707;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1.1fr;
    gap: 42px;
  }
  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--text-primary);
    font-size: 20px;
    font-weight: 750;
    letter-spacing: -0.035em;
  }
  .footer-logo-img {
    height: 30px;
    width: auto;
    display: block;
    filter: drop-shadow(0 2px 8px rgba(216, 61, 42, 0.20));
  }
  .brand-desc {
    color: var(--text-secondary);
    font-size: 14px;
    line-height: 1.6;
    margin: 0;
    max-width: 280px;
  }
  .col-title {
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-primary);
    font-weight: 650;
  }
  .col-links {
    display: flex;
    flex-direction: column;
    gap: 9px;
  }
  .col-links a {
    color: var(--text-secondary);
    font-size: 14px;
    transition: color 150ms ease;
  }
  .col-links a:hover {
    color: var(--text-primary);
  }
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    padding-top: 40px;
    margin-top: 48px;
    border-top: 1px solid var(--border-soft);
    color: var(--text-muted);
    font-size: 12px;
  }
  .sub-notice {
    color: var(--text-secondary);
  }
  .sub-copy {
    font-size: 11px;
    color: var(--text-muted);
  }

  @media (max-width: 860px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 32px;
    }
    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }
  }
  @media (max-width: 520px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>