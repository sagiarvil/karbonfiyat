---
import Layout from "../layouts/Layout.astro";
import CarbonCalculator from "../components/CarbonCalculator.astro";
import ExpertCTA from "../components/ExpertCTA.astro";
import FAQSection from "../components/FAQSection.astro";
import { seoPages } from "../data/seo";

const calcFaqItems = [
  {
    question: "Karbon maliyet hesaplaması için hangi temel verilere ihtiyaç duyulur?",
    answer: "Hesaplama motoru üç temel parametreyle çalışır: 1) İhraç edilen veya üretilen ürün tonajı, 2) Ürünün ton başına spesifik sera gazı emisyon yoğunluğu (Kapsam 1 doğrudan yakıt tüketimi + Kapsam 2 elektrik emisyonu) ve 3) Uygulanacak karbon fiyatı (€/tCO₂e cinsinden CBAM sertifika fiyatı veya Türkiye ETS beklentisi)."
  },
  {
    question: "Şirketimin emisyon faktörünü (tCO₂e / ton) bilmiyorsam ne yapmalıyım?",
    answer: "Tesis düzeyinde doğrulanmış bir karbon ayak izi raporunuz (ISO 14064-1) yoksa, KarbonFiyat motorunda yer alan AB Komisyonu ve sektörel ortalama varsayılan (default) değerleri seçerek ön maliyet analizi yapabilirsiniz. Ancak 2026 yılından itibaren AB'ye ihracatta fiili akredite raporların zorunlu tutulacağını unutmayınız."
  },
  {
    question: "Karbon maliyeti satış fiyatına ve brüt kâr marjına nasıl yansıtılmalı?",
    answer: "Karbon maliyeti doğrudan 'Satılan Malın Maliyeti'ne (SMM) eklenir. Şirketin mevcut brüt marjını koruyabilmesi için ton başına ortaya çıkan net karbon yükünün satış fiyatına eklenmesi gerekir. KarbonFiyat motoru, marjınızı sıfır erozyonla korumanız için gereken hedef satış fiyatını anında simüle eder."
  }
];

const calcSchemas = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "KarbonFiyat Maliyet ve Marj Hesaplama Motoru",
    "applicationCategory": "BusinessApplication",
    "operatingSystem": "Web",
    "description": "Şirket emisyonları, ihracat tonajı ve karbon fiyatını finansal marj ve satış fiyatı kararına dönüştüren hesaplama aracı."
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": calcFaqItems.map(item => ({
      "@type": "Question",
      "name": item.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": item.answer
      }
    }))
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Ana Sayfa",
        "item": "https://karbonfiyat.com"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Karbon Maliyet Hesaplama",
        "item": "https://karbonfiyat.com/karbon-maliyet-hesaplama"
      }
    ]
  }
];
---
<Layout
  title={seoPages.karbonMaliyetHesaplama.title}
  description={seoPages.karbonMaliyetHesaplama.description}
  canonical={seoPages.karbonMaliyetHesaplama.canonical}
  schema={calcSchemas}
>
  <section class="container subhero">
    <span class="eyebrow">DETERMİNİSTİK KARAR MOTORU</span>
    <h1 class="section-title">Karbon Maliyet Hesaplama</h1>
    <p class="lead">
      İhracat, emisyon ve karbon fiyatı verileriyle şirketinizin karbon maliyetini, marj etkisini ve gerekli satış fiyatını hesaplayın.
    </p>
  </section>

  <div class="container">
    <CarbonCalculator />
  </div>

  <FAQSection items={calcFaqItems} />

  <ExpertCTA />
</Layout>

<style>
  .subhero {
    padding: 88px 0 16px;
  }
  .subhero h1 {
    margin: 18px 0 16px;
    font-size: clamp(34px, 4.8vw, 56px);
  }
  @media (max-width: 860px) {
    .subhero { padding-top: 56px; }
  }
</style>