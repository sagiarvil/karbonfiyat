---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BottomNav from '../components/BottomNav.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  noindex?: boolean;
  schema?: Record<string, any> | Record<string, any>[];
}

const {
  title,
  description,
  canonical = Astro.url.pathname,
  noindex = false,
  schema = []
} = Astro.props;

const canonicalUrl = new URL(canonical, 'https://karbonfiyat.com').toString();
const schemas = Array.isArray(schema) ? schema : [schema];
---
<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, minimum-scale=1, maximum-scale=5" />
    <meta name="theme-color" content="#0A0C0F" />
    <meta name="description" content={description} />
    <meta name="keywords" content="karbon fiyatı, cbam fiyatı, skdm maliyet hesaplama, türkiye ets, eua fiyatı, sınırda karbon vergisi, karbon emisyon maliyeti, tco2e, karbon ayak izi hesaplama, carbon pnl, demir çelik cbam, alüminyum skdm" />
    <meta name="author" content="KarbonFiyat" />
    <meta name="robots" content={noindex ? 'noindex,nofollow' : 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1'} />
    <meta name="geo.region" content="TR" />
    <meta name="geo.position" content="39.9208;32.8541" />
    <meta name="ICBM" content="39.9208, 32.8541" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/logo/karbonfiyat-logo.png" type="image/png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/logo/karbonfiyat-logo.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/logo/karbonfiyat-logo.png" />
    <link rel="apple-touch-icon" href="/logo/karbonfiyat-logo.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="describedby" href="https://karbonfiyat.com/llms.txt" type="text/plain" />
    <link rel="alternate" href="https://karbonfiyat.com/index.md" type="text/markdown" title="KarbonFiyat machine-readable index" />
    <link rel="alternate" type="application/rss+xml" title="KarbonFiyat RSS" href="/feed.xml" />
    <link rel="alternate" type="application/atom+xml" title="KarbonFiyat Atom" href="/atom.xml" />
    <link rel="alternate" type="application/feed+json" title="KarbonFiyat JSON Feed" href="/feed.json" />
    <link rel="alternate" type="application/rss+xml" title="KarbonFiyat Mobile Voice Feed" href="/mobile/feed.xml" />
    <link rel="hub" href="https://pubsubhubbub.appspot.com/" />

    <!-- MOBILE-FIRST PWA & APP METAS -->
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="KarbonFiyat" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="format-detection" content="telephone=yes,address=yes,email=yes" />

    <title>{title}</title>

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:site_name" content="KarbonFiyat" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content="https://karbonfiyat.com/og-karbonfiyat.svg" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://karbonfiyat.com/og-karbonfiyat.svg" />

    {schemas.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
  </head>
  <body>
    <Header />
    <main><slot /></main>
    <Footer />
    <BottomNav />

    <script is:inline>
      if ('serviceWorker' in navigator && window.location.protocol === 'https:') {
        window.addEventListener('load', function() {
          navigator.serviceWorker.register('/sw.js').catch(function() {});
        });
      }
    </script>
  </body>
</html>
