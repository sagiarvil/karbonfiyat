---
const timelineCards = [
  {
    date: "1 OCAK 2026",
    status: "YÜRÜRLÜKTE",
    statusClass: "active",
    title: "SKDM Mali Dönemi Başladı",
    desc: "AB Komisyonu (EU 2023/956) geçiş dönemi bitti. Parasal yükümlülük takvimi işliyor; Avrupalı ithalatçılar sertifika maliyetini tedarikçilere yansıtmaya başladı.",
    legalRef: "Resmî Dayanak: Tüzük (AB) 2023/956 Madde 22"
  },
  {
    date: "27 AĞUSTOS 2026",
    status: "YASAL TAKVİM",
    statusClass: "upcoming",
    title: "Türkiye ETS Yürürlüğe Giriyor",
    desc: "Ulusal Emisyon Ticaret Sistemi (TR-ETS) devreye giriyor. İç piyasadaki tesisler için tahsisat sınırları ve karbon fiyatlama mekanizması resmen başlıyor.",
    legalRef: "Resmî Dayanak: T.C. İklim Kanunu Taslağı & Tebliğleri"
  },
  {
    date: "30 EYLÜL 2027",
    status: "KESİN BEYAN",
    statusClass: "warning",
    title: "İlk Resmî Sertifika Teslimi",
    desc: "2026 yılı ihracatına ait gömülü emisyonlar için ilk CBAM sertifika satın alma ve teslim zorunluluğu. Doğrulanmamış veriler ceza ve gümrük blokajı getirir.",
    legalRef: "Resmî Dayanak: CBAM Registry Yıllık Kapatma Takvimi"
  }
];
---

<section class="timeline-strip-section" id="takvim">
  <div class="container">
    <div class="strip-header">
      <span class="eyebrow">YASAL TAKVİM &amp; ZAMANLAMA</span>
      <h2 class="strip-title">Neden şimdi? Geri sayım değil, resmî regülasyon.</h2>
      <p class="strip-sub">
        Türk sanayicisi için karbon artık çevre raporu değil; bilançoyu, brüt marjı ve AB gümrük geçişini kilitleyen doğrudan finansal yasal takvimdir.
      </p>
    </div>

    <div class="timeline-grid">
      {timelineCards.map((card) => (
        <article class="timeline-card">
          <div class="card-top">
            <span class="card-date mono">{card.date}</span>
            <span class={`card-status chip ${card.statusClass}`}>{card.status}</span>
          </div>
          <h3 class="card-title">{card.title}</h3>
          <p class="card-desc">{card.desc}</p>
          <div class="card-legal mono">{card.legalRef}</div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .timeline-strip-section {
    padding: 72px 0;
    border-top: 1px solid var(--border-soft);
    border-bottom: 1px solid var(--border-soft);
    background: #0D1015;
  }

  .strip-header {
    max-width: 820px;
    margin-bottom: 40px;
  }

  .strip-title {
    font-size: clamp(28px, 3.6vw, 40px);
    line-height: 1.15;
    color: var(--text-primary);
    margin: 12px 0 10px;
    letter-spacing: -0.03em;
  }

  .strip-sub {
    font-size: 15px;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  .timeline-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .timeline-card {
    background: #14171C;
    border: 1px solid var(--border-soft);
    border-radius: 16px;
    padding: 28px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 250px;
    transition: border-color 150ms ease, transform 150ms ease;
  }

  .timeline-card:hover {
    border-color: rgba(255, 255, 255, 0.18);
    transform: translateY(-2px);
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
  }

  .card-date {
    font-size: 13px;
    font-weight: 750;
    letter-spacing: 0.04em;
    color: #60A5FA;
  }

  .card-status.active {
    background: rgba(43, 92, 230, 0.15);
    color: #93C5FD;
    border: 1px solid rgba(43, 92, 230, 0.35);
  }

  .card-status.upcoming {
    background: rgba(255, 255, 255, 0.05);
    color: var(--text-secondary);
    border: 1px solid var(--border-soft);
  }

  .card-status.warning {
    background: rgba(217, 119, 6, 0.15);
    color: #FBBF24;
    border: 1px solid rgba(217, 119, 6, 0.35);
  }

  .card-title {
    font-size: 20px;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 10px;
    line-height: 1.25;
  }

  .card-desc {
    font-size: 13px;
    line-height: 1.6;
    color: var(--text-secondary);
    margin: 0 0 20px;
    flex-grow: 1;
  }

  .card-legal {
    font-size: 11px;
    color: var(--text-muted);
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    padding-top: 12px;
  }

  @media (max-width: 920px) {
    .timeline-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
