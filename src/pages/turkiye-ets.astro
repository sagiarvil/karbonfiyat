---
import Layout from "../layouts/Layout.astro";
import ScenarioPanel from "../components/ScenarioPanel.astro";
import ExpertCTA from "../components/ExpertCTA.astro";
import FAQSection from "../components/FAQSection.astro";
import { seoPages } from "../data/seo";

const etsFaqItems = [
  {
    question: "Türkiye Emisyon Ticaret Sistemi (ETS) ne zaman yürürlüğe girecek?",
    answer: "İklim Değişikliği Başkanlığı tarafından hazırlanan İklim Kanunu ve ETS Yönetmeliği taslağı kapsamında, Türkiye ETS'nin pilot uygulamasının başlatılması ve ardından kademeli olarak kesin tahsisat ve teslim dönemine geçilmesi planlanmaktadır. Şirketlerin mevzuat yürürlüğe girmeden önce emisyon izleme, raporlama ve doğrulama (İRD) altyapılarını tamamlamaları kritik önemdedir."
  },
  {
    question: "Hangi sektörler ve sanayi tesisleri Türkiye ETS kapsamına dahil olacak?",
    answer: "İlk aşamada enerji üretim santralleri, demir-çelik, çimento, kireç, seramik, cam, kâğıt ve kimya gibi yıllık Kapsam 1 doğrudan emisyonu 50.000 tCO₂e ve üzerinde olan enerji-yoğun sanayi tesislerinin sisteme dahil edilmesi öngörülmektedir."
  },
  {
    question: "Türkiye ETS'de ödenen karbon bedeli AB CBAM sertifikalarından mahsup edilir mi?",
    answer: "Evet. AB CBAM Tüzüğü Madde 9 hükmüne göre, menşe ülkede (Türkiye) fiilen ödenmiş ve doğrulanmış bir karbon bedeli varsa, bu bedel AB'de teslim edilecek CBAM sertifikası tutarından tam olarak düşülür (mahsup edilir). Bu sayede Türk ihracatçısı çifte karbon vergilendirmesinden korunur."
  },
  {
    question: "Tesisler için serbest tahsisat (ücretsiz kota) nasıl belirlenecektir?",
    answer: "Türkiye ETS'de tesislerin tarihsel üretim verileri ve AB'deki gibi sektörel emisyon referans değerleri (benchmark) esas alınarak belirli bir oranda serbest tahsisat tanımlanacaktır. Referans değerin üzerinde salım yapan tesisler aradaki fark için piyasadan tahsisat satın almak zorunda kalacaktır."
  }
];

const etsSchemas = [
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": etsFaqItems.map(item => ({
      "@type": "Question",
      "name": item.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": item.answer
      }
    }))
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Ana Sayfa",
        "item": "https://karbonfiyat.com"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Türkiye ETS",
        "item": "https://karbonfiyat.com/turkiye-ets"
      }
    ]
  }
];
---
<Layout
  title={seoPages.turkiyeEts.title}
  description={seoPages.turkiyeEts.description}
  canonical={seoPages.turkiyeEts.canonical}
  schema={etsSchemas}
>
  <section class="container subhero">
    <span class="eyebrow">TÜRKİYE ETS</span>
    <h1 class="section-title">Türkiye ETS fiyatı oluşmadan şirket bütçenizi hazırlayın.</h1>
    <p class="lead">
      Resmî piyasa fiyatı oluşana kadar kullanıcı senaryoları ile karbon maliyetinizi, marj etkisini ve bütçe riskini modelleyin.
    </p>
  </section>

  <section class="container status-section">
    <div class="matrix card">
      <div class="matrix-cell">
        <span class="matrix-label">Durum</span>
        <strong class="matrix-val">Taslak / Hazırlık</strong>
      </div>
      <div class="matrix-cell">
        <span class="matrix-label">Resmî Fiyat</span>
        <strong class="matrix-val">Henüz Oluşmadı</strong>
      </div>
      <div class="matrix-cell">
        <span class="matrix-label">Model</span>
        <strong class="matrix-val">Cap + Tahsisat + Teslim</strong>
      </div>
      <div class="matrix-cell">
        <span class="matrix-label">Finansal Kullanım</span>
        <strong class="matrix-val">Senaryo / Bütçe</strong>
      </div>
    </div>
  </section>

  <div class="container">
    <ScenarioPanel />
  </div>

  <section class="container info-section">
    <div class="info-grid">
      <article class="card info-card">
        <span class="eyebrow">Yasal Altyapı</span>
        <h3>İklim Kanunu ve Tahsisat</h3>
        <p>
          İklim Kanunu ETS için yasal çerçeveyi oluşturmuştur. İklim Değişikliği Başkanlığı kaynaklarında ETS Yönetmeliği halen taslak olarak yer almakta ve yürürlüğe koyma çalışmaları sürmektedir.
        </p>
      </article>
      <article class="card info-card">
        <span class="eyebrow">CBAM İlişkisi</span>
        <h3>Madde 9 Mahsup Potansiyeli</h3>
        <p>
          Menşe ülkede fiilen ödenmiş bir karbon fiyatının CBAM kapsamında dikkate alınması, AB kuralları uyarınca kanıt ve uygunluk koşullarına bağlıdır. Buradaki mahsup oranı yalnız senaryo girdisidir; kesin hak veya indirim değildir.
        </p>
      </article>
    </div>
  </section>

  <FAQSection items={etsFaqItems} />

  <ExpertCTA
    headline="TR ETS hazırlığınızı uzmanlarla tamamlayın."
    subtext="Tesis emisyon verinizi, tahsisat varsayımlarını ve bütçe senaryolarını güncel resmî çerçeveye göre ayrıca doğrulayın."
  />
</Layout>

<style>
  .subhero {
    padding: 88px 0 32px;
  }
  .subhero h1 {
    margin: 18px 0 16px;
    font-size: clamp(34px, 4.8vw, 56px);
  }
  .status-section {
    margin-top: 12px;
  }
  .matrix {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    padding: 10px;
    background: linear-gradient(180deg, #121515 0%, #0E1010 100%);
    border: 1px solid var(--border-soft);
  }
  .matrix-cell {
    padding: 24px 20px;
    border-right: 1px solid var(--border-soft);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .matrix-cell:last-child {
    border-right: 0;
  }
  .matrix-label {
    font-size: 11px;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .matrix-val {
    font-size: 20px;
    color: var(--text-primary);
    letter-spacing: -0.02em;
  }

  .info-section {
    margin-top: 56px;
  }
  .info-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .info-card {
    padding: 36px;
  }
  .info-card h3 {
    font-size: 22px;
    margin: 14px 0 10px;
    color: var(--text-primary);
  }
  .info-card p {
    color: var(--text-secondary);
    font-size: 14px;
    line-height: 1.65;
    margin: 0;
  }

  @media (max-width: 860px) {
    .subhero { padding-top: 56px; }
    .matrix { grid-template-columns: 1fr 1fr; }
    .matrix-cell:nth-child(2) { border-right: 0; }
    .matrix-cell:nth-child(-n+2) { border-bottom: 1px solid var(--border-soft); }
    .info-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 540px) {
    .matrix { grid-template-columns: 1fr; }
    .matrix-cell { border-right: 0; border-bottom: 1px solid var(--border-soft); }
    .matrix-cell:last-child { border-bottom: 0; }
  }
</style>