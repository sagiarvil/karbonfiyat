---
import Layout from "../layouts/Layout.astro";
import MarketPriceCard from "../components/MarketPriceCard.astro";
import ExpertCTA from "../components/ExpertCTA.astro";
import { marketPrices } from "../data/market-prices";
import { seoPages } from "../data/seo";
---
<Layout
  title={seoPages.karbonFiyati.title}
  description={seoPages.karbonFiyati.description}
  canonical={seoPages.karbonFiyati.canonical}
>
  <section class="container subhero">
    <span class="eyebrow">PİYASA VE REGÜLASYON İZLEME</span>
    <h1 class="section-title">Karbon fiyatı tek bir sayı değildir.</h1>
    <p class="lead">
      CBAM sertifika fiyatı, EU ETS piyasa fiyatı ve Türkiye ETS fiyatı farklı mekanizmalardır.
      Finansal modelleme yaparken spekülatif piyasa feed\x27leri ile yasal bağlayıcılığı olan resmî katsayılar birbirinden ayrılmalıdır.
    </p>
  </section>

  <section class="container prices-grid-section">
    <div class="market-cards-grid">
      {marketPrices.map(card => (
        <MarketPriceCard card={card} />
      ))}
    </div>
  </section>

  <section class="container comparison-section">
    <div class="card compare-card">
      <span class="eyebrow">Mekanizma Karşılaştırması</span>
      <h2>Üç Rejimin Finansal Anlamı</h2>
      <div class="compare-grid">
        <div class="compare-col">
          <strong class="compare-name">CBAM</strong>
          <span class="chip">RESMÎ DÖNEM FİYATI</span>
          <p>AB ithalatçısı tarafından ödenen, çeyreklik resmî açık artırma ağırlıklı ortalamasıyla kesinleşen yasal sertifika bedelidir.</p>
        </div>
        <div class="compare-col">
          <strong class="compare-name">EU ETS</strong>
          <span class="chip">PİYASA FİYATI</span>
          <p>Avrupa Enerji Borsası\x27nda arz-talep dengesine göre anlık değişen, spot ve vadeli enstrümanları içeren piyasa kotasyonudur.</p>
        </div>
        <div class="compare-col">
          <strong class="compare-name">TÜRKİYE ETS</strong>
          <span class="chip warning">ULUSAL PİYASA / HENÜZ OLUŞMADI</span>
          <p>Türkiye İklim Değişikliği Başkanlığı gözetiminde pilot aşamasında olan; henüz borsa fiyatı oluşmamış ulusal mekanizmadır.</p>
        </div>
      </div>
    </div>
  </section>

  <ExpertCTA />
</Layout>

<style>
  .subhero {
    padding: 88px 0 32px;
  }
  .subhero h1 {
    margin: 18px 0 16px;
    font-size: clamp(34px, 4.8vw, 56px);
  }
  .market-cards-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-top: 16px;
  }
  .comparison-section {
    margin-top: 56px;
  }
  .compare-card {
    padding: 44px;
  }
  .compare-card h2 {
    font-size: 28px;
    margin: 14px 0 28px;
    color: var(--text-primary);
  }
  .compare-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .compare-col {
    display: flex;
    flex-direction: column;
    gap: 10px;
    align-items: flex-start;
  }
  .compare-name {
    font-size: 18px;
    color: var(--text-primary);
  }
  .compare-col p {
    color: var(--text-secondary);
    font-size: 14px;
    line-height: 1.6;
    margin: 0;
  }

  @media (max-width: 860px) {
    .subhero { padding-top: 56px; }
    .market-cards-grid { grid-template-columns: 1fr; }
    .compare-grid { grid-template-columns: 1fr; }
    .compare-card { padding: 28px; }
  }
</style>