---
interface Props {
  headline?: string;
  subtext?: string;
}
const {
  headline = "Rakamı gördünüz. Şimdi kararını çıkarın.",
  subtext = "Şirketinizin ürün, müşteri, marj ve fiyatlama etkisini uzman kontrolüyle detaylandırın."
} = Astro.props;
---
<section class="container expert-cta-wrap">
  <div class="expert-card card">
    <div class="expert-copy">
      <span class="eyebrow">Stratejik Karar Desteği</span>
      <h2>{headline}</h2>
      <p class="lead">{subtext}</p>
    </div>
    <div class="expert-actions">
      <a class="btn btn-primary" href="https://degerlet.com" rel="noopener" target="_blank">
        Uzman değerlendirmesi al
      </a>
      <small class="expert-note mono">degerlet.com üzerinden</small>
    </div>
  </div>
</section>

<style>
  .expert-cta-wrap {
    margin-top: 96px;
  }
  .expert-card {
    padding: 48px;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 40px;
    background: linear-gradient(180deg, #121515 0%, #0E1010 100%);
    border: 1px solid var(--border-soft);
  }
  .expert-copy h2 {
    font-size: clamp(28px, 3.6vw, 38px);
    line-height: 1.1;
    margin: 14px 0 10px;
    color: var(--text-primary);
  }
  .expert-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 8px;
    flex-shrink: 0;
  }
  .expert-note {
    font-size: 11px;
    color: var(--text-muted);
  }
  @media (max-width: 860px) {
    .expert-card {
      flex-direction: column;
      align-items: flex-start;
      padding: 32px;
    }
    .expert-actions {
      align-items: flex-start;
      width: 100%;
    }
    .expert-actions .btn {
      width: 100%;
    }
  }
</style>
