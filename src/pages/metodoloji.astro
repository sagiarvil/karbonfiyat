---
import Layout from "../layouts/Layout.astro";
import MethodCard from "../components/MethodCard.astro";
import ExpertCTA from "../components/ExpertCTA.astro";
import { methodologyPillars } from "../data/methodology";
import { seoPages } from "../data/seo";
---
<Layout
  title={seoPages.metodoloji.title}
  description={seoPages.metodoloji.description}
  canonical={seoPages.metodoloji.canonical}
>
  <section class="container subhero">
    <span class="eyebrow">VERİ VE HESAPLAMA STANDARDI</span>
    <h1 class="section-title">Her sonuç yeniden üretilebilir olmalı.</h1>
    <p class="lead">
      Finansal karar ancak kullanılan fiyat, katsayı ve mevzuatın kaynağı biliniyorsa güvenilirdir.
      KarbonFiyat’ın otoritesi tahminlerden değil, denetlenebilir matematik ve resmi veri katmanlarından gelir.
    </p>
  </section>

  <section class="container methods-grid-section" id="kaynaklar">
    <div class="methods-grid">
      {methodologyPillars.map(pillar => (
        <MethodCard
          step={pillar.step}
          title={pillar.title}
          description={pillar.description}
          badge={pillar.badge}
        />
      ))}
    </div>
  </section>

  <section class="container eeat-section">
    <div class="card eeat-mentor-card">
      <div class="eeat-top-bar">
        <span class="eyebrow">METODOLOJİ VE HESAPLAMA GÜVENCESİ</span>
        <a href="https://www.linkedin.com/in/barisbagirlar/" target="_blank" rel="noopener" class="eeat-link">
          LinkedIn Profili ↗
        </a>
      </div>
      <div class="eeat-content-row">
        <div class="eeat-avatar-frame">
          <img src="/images/baris-bagirlar-thumb.jpg" alt="Barış Bağırlar" class="eeat-avatar-img" width="68" height="68" loading="lazy" />
        </div>
        <div>
          <h2>Barış Bağırlar</h2>
          <p class="eeat-titles">
            <strong>Tarımkon (Uluslararası Tarım ve Gıda Konfederasyonu)</strong> Danışma Kurulu Üyesi<br />
            <strong>Gaziantep Üniversitesi</strong> TS EN ISO 14064-1 Kurumsal Karbon Ayak İzi Hesaplama Mentörü
          </p>
          <p class="eeat-bio">
            KarbonFiyat metodoloji mimarisi, uluslararası sera gazı muhasebesi standartları (TS EN ISO 14064-1, GHG Protocol) ve AB Komisyonu (EU 2023/956) uygulama yönetmelikleri doğrultusunda Barış Bağırlar danışmanlığında modellenmektedir.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="container policy-section" id="veri-politikasi">
    <div class="card policy-card">
      <span class="eyebrow">Yasal &amp; Güvenlik Beyanı</span>
      <h2>Veri Gizliliği ve Tarafsızlık</h2>
      <p>
        KarbonFiyat üzerindeki ön hesaplamalar hiçbir ticari ve operasyonel veriyi harici sunuculara göndermez.
        Tüm algoritmalar yerel tarayıcı belleğinde icra edilir. Platformun resmî kurumlar, borsa operatörleri veya karbon satıcılarıyla herhangi bir komisyon bağı bulunmamaktadır.
      </p>
    </div>
  </section>

  <ExpertCTA />
</Layout>

<style>
  .subhero {
    padding: 88px 0 32px;
  }
  .subhero h1 {
    margin: 18px 0 16px;
    font-size: clamp(34px, 4.8vw, 56px);
  }
  .methods-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 16px;
  }
  .eeat-section {
    margin-top: 56px;
  }
  .eeat-mentor-card {
    padding: 40px;
    background: linear-gradient(180deg, #111515 0%, #0C0F0F 100%);
    border: 1px solid rgba(201, 167, 97, 0.35);
  }
  .eeat-top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--border-soft);
    padding-bottom: 14px;
    margin-bottom: 24px;
    flex-wrap: wrap;
    gap: 10px;
  }
  .eeat-link {
    font-size: 13px;
    color: var(--text-primary);
    font-weight: 600;
  }
  .eeat-link:hover {
    color: #E6C687;
  }
  .eeat-content-row {
    display: flex;
    gap: 24px;
    align-items: flex-start;
  }
  .eeat-avatar-frame {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    border: 2px solid rgba(201, 167, 97, 0.6);
    box-shadow: 0 0 16px rgba(201, 167, 97, 0.25);
    overflow: hidden;
    flex-shrink: 0;
    background: #0D1010;
  }
  .eeat-avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .eeat-content-row h2 {
    font-size: 24px;
    margin: 0 0 8px;
    color: var(--text-primary);
  }
  .eeat-titles {
    font-size: 14px;
    color: #E6C687;
    line-height: 1.6;
    margin: 0 0 12px;
  }
  .eeat-titles strong {
    color: var(--text-primary);
  }
  .eeat-bio {
    font-size: 14px;
    line-height: 1.65;
    color: var(--text-secondary);
    margin: 0;
  }

  .policy-section {
    margin-top: 56px;
  }
  .policy-card {
    padding: 44px;
  }
  .policy-card h2 {
    font-size: 26px;
    margin: 14px 0 12px;
    color: var(--text-primary);
  }
  .policy-card p {
    color: var(--text-secondary);
    font-size: 14px;
    line-height: 1.65;
    margin: 0;
    max-width: 820px;
  }

  @media (max-width: 860px) {
    .subhero { padding-top: 56px; }
    .methods-grid { grid-template-columns: 1fr; }
    .policy-card { padding: 28px; }
    .eeat-content-row { flex-direction: column; gap: 16px; }
  }
</style>