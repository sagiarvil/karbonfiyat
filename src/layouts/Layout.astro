---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  noindex?: boolean;
  schema?: Record<string, any> | Record<string, any>[];
}

const {
  title,
  description,
  canonical = Astro.url.pathname,
  noindex = false,
  schema = []
} = Astro.props;

const canonicalUrl = new URL(canonical, 'https://karbonfiyat.com').toString();
const schemas = Array.isArray(schema) ? schema : [schema];
---
<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0A0C0F" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex,nofollow' : 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1'} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/logo/karbonfiyat-logo.png" type="image/png" />
    <link rel="apple-touch-icon" href="/logo/karbonfiyat-logo.png" />
    <title>{title}</title>

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:site_name" content="KarbonFiyat" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content="https://karbonfiyat.com/og-karbonfiyat.svg" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://karbonfiyat.com/og-karbonfiyat.svg" />

    {schemas.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
  </head>
  <body>
    <Header />
    <main><slot /></main>
    <Footer />
  </body>
</html>
