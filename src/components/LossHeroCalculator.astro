---
interface Props {
  defaultSector?: string;
  defaultVolume?: number;
  defaultSalesPrice?: number;
}

const {
  defaultSector = "steel",
  defaultVolume = 10000,
  defaultSalesPrice = 850
} = Astro.props;

// Sektör varsayılan emisyon katsayıları (tCO2e / ton)
const sectorData = [
  { id: "steel", name: "Demir & Çelik", factor: 1.84, defaultPrice: 850, note: "Gömülü emisyon katsayısı: 1.84 tCO₂e/t" },
  { id: "aluminum", name: "Alüminyum", factor: 4.20, defaultPrice: 2400, note: "Gömülü emisyon katsayısı: 4.20 tCO₂e/t" },
  { id: "cement", name: "Çimento", factor: 0.65, defaultPrice: 95, note: "Gömülü emisyon katsayısı: 0.65 tCO₂e/t" },
  { id: "fertilizer", name: "Gübre", factor: 2.10, defaultPrice: 420, note: "Gömülü emisyon katsayısı: 2.10 tCO₂e/t" }
];
---

<section class="loss-hero-section">
  <div class="container">
    <!-- Üst Başlık & Otorite Sinyali -->
    <div class="hero-header">
      <div class="status-chip">
        <span class="pulse-dot" aria-hidden="true"></span>
        <span class="status-text">2026 MALİ DÖNEMİ BAŞLADI · 1 OCAK 2026 YÜRÜRLÜK</span>
      </div>
      <h1 class="hero-loss-title">
        AB'ye ihracat mı yapıyorsunuz?<br />
        <span class="highlight-loss">SKDM kârınızı sessizce eritiyor olabilir.</span>
      </h1>
      <p class="hero-loss-sub">
        Demir-çelik, alüminyum, çimento ve gübre üreticisi KOBİ'ler için: AB ithalatçınız maliyeti size rücu etmeden önce gerçek maruziyetinizi ve marj kaybınızı 5 saniyede hesaplayın.
      </p>
    </div>

    <!-- Mini Hesaplayıcı & Kilitli Teaser Kartı -->
    <div class="calculator-hero-card">
      <!-- Sol: Girdi Formu -->
      <div class="calc-input-pane">
        <div class="pane-header">
          <span class="pane-tag">GÖSTERGE HESAPLAMA MOTORU</span>
          <h2 class="pane-title">İhracat Parametreleriniz</h2>
        </div>

        <form class="hero-calc-form" onsubmit="return false;">
          <!-- Sektör Seçimi -->
          <div class="form-group">
            <label class="input-label" for="sector-select">Sektör / Ürün Grubu</label>
            <div class="select-wrapper">
              <select id="sector-select" class="calc-select">
                {sectorData.map((s) => (
                  <option value={s.id} data-factor={s.factor} data-price={s.defaultPrice} selected={s.id === defaultSector}>
                    {s.name} ({s.factor} tCO₂e/t)
                  </option>
                ))}
              </select>
              <span class="select-arrow" aria-hidden="true">▾</span>
            </div>
            <span class="input-hint" id="sector-hint">Ortalama gömülü emisyon: 1.84 tCO₂e / ton</span>
          </div>

          <!-- Yıllık AB Satış Tonajı -->
          <div class="form-group">
            <div class="label-row">
              <label class="input-label" for="volume-input">Yıllık AB İhracat Tonajı</label>
              <span class="quick-preset-label">Hızlı Seçim</span>
            </div>
            <div class="input-with-unit">
              <input type="number" id="volume-input" class="calc-input" min="100" step="500" value={defaultVolume} />
              <span class="unit-tag">ton / yıl</span>
            </div>
            <div class="preset-pills">
              <button type="button" class="pill-btn" data-val="2500">2.500</button>
              <button type="button" class="pill-btn" data-val="5000">5.000</button>
              <button type="button" class="pill-btn active" data-val="10000">10.000</button>
              <button type="button" class="pill-btn" data-val="25000">25.000</button>
            </div>
          </div>

          <!-- Ortalama Satış Fiyatı -->
          <div class="form-group">
            <label class="input-label" for="price-input">Ortalama Satış Fiyatınız (FOB/CIF)</label>
            <div class="input-with-unit">
              <input type="number" id="price-input" class="calc-input" min="50" step="10" value={defaultSalesPrice} />
              <span class="unit-tag">€ / ton</span>
            </div>
          </div>

          <div class="calc-meta-info">
            <div class="meta-row">
              <span class="meta-label">Resmî CBAM Fiyat Göstergesi:</span>
              <span class="meta-value">€75,28 / tCO₂ (AB Komisyonu 2026/Q2)</span>
            </div>
            <div class="meta-row">
              <span class="meta-label">Hesaplama Mantığı:</span>
              <span class="meta-value">Deterministik · Sıfır AI Halüsinasyonu</span>
            </div>
          </div>
        </form>
      </div>

      <!-- Sağ: Kilitli Sonuç & Paynkolay Odaklı Büyük Kutu -->
      <div class="calc-result-pane">
        <div class="result-badge-row">
          <span class="result-badge">TAHMİNİ BRÜT MARUZİYET</span>
          <span class="verified-tag">✓ 2026 Regülasyon Kuralı</span>
        </div>

        <!-- Büyük Parasal Kayıp Kutusu -->
        <div class="exposure-hero-box">
          <span class="exposure-lead">Tahmini Yıllık Karbon Maliyet Maruziyetiniz:</span>
          <div class="exposure-number-wrap">
            <span class="exposure-val" id="display-exposure">€1.385.152</span>
          </div>
          <p class="exposure-desc">
            Bu tutar, ürününüzün AB gümrüğünde beyan edilmemesi veya mahsup edilmemesi durumunda <strong>ithalatçınız tarafından talep edilecek doğrudan brüt maliyettir</strong>.
          </p>
        </div>

        <!-- Kilitli Detay Analiz Izgarası (Teaser / Kayıp Derinliği) -->
        <div class="locked-metrics-grid">
          <div class="locked-kpi-card">
            <div class="locked-header">
              <span class="locked-name">Ton Başı Net Ek Yük</span>
              <span class="lock-icon" title="Ön Analiz Raporu ile açılır">🔒</span>
            </div>
            <div class="blur-value-wrap">
              <span class="blurred-val" id="display-per-ton">€138,52/t</span>
              <span class="locked-overlay-tag">KİLİTLİ</span>
            </div>
          </div>

          <div class="locked-kpi-card danger-accent">
            <div class="locked-header">
              <span class="locked-name">Gerçek Brüt Marj Kaybı</span>
              <span class="lock-icon" title="Ön Analiz Raporu ile açılır">🔒</span>
            </div>
            <div class="blur-value-wrap">
              <span class="blurred-val danger-text" id="display-margin-loss">−%16,3 puan</span>
              <span class="locked-overlay-tag">KİLİTLİ</span>
            </div>
          </div>

          <div class="locked-kpi-card">
            <div class="locked-header">
              <span class="locked-name">Zarara Geçiren Kırılma Fiyatı</span>
              <span class="lock-icon" title="Ön Analiz Raporu ile açılır">🔒</span>
            </div>
            <div class="blur-value-wrap">
              <span class="blurred-val" id="display-breakeven">€68,40/t</span>
              <span class="locked-overlay-tag">KİLİTLİ</span>
            </div>
          </div>

          <div class="locked-kpi-card">
            <div class="locked-header">
              <span class="locked-name">Marjı Koruyan Fiyat Zammı</span>
              <span class="lock-icon" title="Ön Analiz Raporu ile açılır">🔒</span>
            </div>
            <div class="blur-value-wrap">
              <span class="blurred-val" id="display-price-rev">+%16,3 revizyon</span>
              <span class="locked-overlay-tag">KİLİTLİ</span>
            </div>
          </div>
        </div>

        <!-- Funnel Kilit Açma CTA'sı -->
        <div class="unlock-action-box">
          <div class="unlock-info">
            <div class="price-stack">
              <span class="price-origin">Ön Analiz Raporu</span>
              <span class="price-main">4.900 TL</span>
              <span class="price-sub">+ KDV · 1 İş Gününde Teslim</span>
            </div>
            <p class="unlock-statement">
              Tesis ve GTIP kodlarınıza özel net CBAM yükümlülüğü, üçüncü ülke mahsup senaryosu ve kilitli 4 kritik metrik <strong>yönetici özet raporu</strong> olarak teslim edilir.
            </p>
          </div>
          <a href="#basvuru" class="btn btn-unlock" id="btn-unlock-cta">
            <span>Gerçek Karbon Maliyetimi & Savunma Raporumu Al</span>
            <span class="btn-arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function() {
    const sectorEl = document.getElementById("sector-select");
    const volumeEl = document.getElementById("volume-input");
    const priceEl = document.getElementById("price-input");
    const hintEl = document.getElementById("sector-hint");
    const pills = document.querySelectorAll(".pill-btn");

    const dispExposure = document.getElementById("display-exposure");
    const dispPerTon = document.getElementById("display-per-ton");
    const dispMarginLoss = document.getElementById("display-margin-loss");
    const dispBreakeven = document.getElementById("display-breakeven");
    const dispPriceRev = document.getElementById("display-price-rev");

    const cbamPrice = 75.28; // AB Komisyonu resmi gösterge fiyatı

    const fmtEur = new Intl.NumberFormat("tr-TR", { style: "currency", currency: "EUR", maximumFractionDigits: 0 });
    const fmtEurDec = new Intl.NumberFormat("tr-TR", { style: "currency", currency: "EUR", minimumFractionDigits: 2, maximumFractionDigits: 2 });
    const fmtPct = new Intl.NumberFormat("tr-TR", { minimumFractionDigits: 1, maximumFractionDigits: 1 });

    function calculate() {
      const selectedOption = sectorEl ? sectorEl.options[sectorEl.selectedIndex] : null;
      const factor = selectedOption ? parseFloat(selectedOption.getAttribute("data-factor") || "1.84") : 1.84;
      const vol = Math.max(1, parseFloat(volumeEl ? volumeEl.value : "10000") || 10000);
      const salesPrice = Math.max(1, parseFloat(priceEl ? priceEl.value : "850") || 850);

      // Toplam maruziyet = Tonaj * Gömülü Emisyon * CBAM Fiyatı
      const totalExposure = vol * factor * cbamPrice;
      const perTonCost = factor * cbamPrice;

      // Varsayılan standart brüt marj %25 üzerinden marj erimesi
      const marginLossPct = (perTonCost / salesPrice) * 100;
      const requiredPriceRevision = (perTonCost / salesPrice) * 100;
      const breakEvenCarbonPrice = (salesPrice * 0.25) / factor; // marjı sıfırlayan karbon fiyatı

      if (dispExposure) dispExposure.textContent = fmtEur.format(totalExposure);
      if (dispPerTon) dispPerTon.textContent = fmtEurDec.format(perTonCost) + "/t";
      if (dispMarginLoss) dispMarginLoss.textContent = "−%" + fmtPct.format(marginLossPct) + " puan";
      if (dispBreakeven) dispBreakeven.textContent = fmtEurDec.format(breakEvenCarbonPrice) + "/t";
      if (dispPriceRev) dispPriceRev.textContent = "+%" + fmtPct.format(requiredPriceRevision);
    }

    if (sectorEl) {
      sectorEl.addEventListener("change", function() {
        const selectedOption = sectorEl.options[sectorEl.selectedIndex];
        const factor = selectedOption.getAttribute("data-factor");
        const defaultP = selectedOption.getAttribute("data-price");
        if (hintEl) hintEl.textContent = "Ortalama gömülü emisyon: " + factor + " tCO₂e / ton";
        if (priceEl && defaultP) priceEl.value = defaultP;
        calculate();
      });
    }

    if (volumeEl) volumeEl.addEventListener("input", calculate);
    if (priceEl) priceEl.addEventListener("input", calculate);

    pills.forEach(function(pill) {
      pill.addEventListener("click", function() {
        pills.forEach(function(p) { p.classList.remove("active"); });
        pill.classList.add("active");
        if (volumeEl) {
          volumeEl.value = pill.getAttribute("data-val") || "10000";
          calculate();
        }
      });
    });

    calculate();
  })();
</script>

<style>
