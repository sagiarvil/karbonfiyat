---
import Layout from '../layouts/Layout.astro';
import PriceStrip from '../components/PriceStrip.astro';
import Calculator from '../components/Calculator.astro';
import DecisionPanel from '../components/DecisionPanel.astro';

const schema = [
  {
    '@context':'https://schema.org',
    '@type':'Organization',
    name:'KarbonFiyat',
    url:'https://karbonfiyat.com',
    description:'Karbon fiyatını şirket maliyeti, marj ve fiyatlama kararına çeviren finansal karar platformu.'
  },
  {
    '@context':'https://schema.org',
    '@type':'WebSite',
    name:'KarbonFiyat',
    url:'https://karbonfiyat.com'
  }
];
---
<Layout title="KarbonFiyat | Karbon Fiyatını Şirket Maliyetine Çevirin" description="CBAM, EU ETS ve Türkiye ETS fiyatlarını ürün maliyeti, marj ve şirket kârlılığına çevirin. Karbon maliyetinizi hesaplayın." schema={schema}>
  <section class="hero grid-overlay">
    <div class="container hero-inner">
      <div class="hero-copy">
        <div class="tag"><span class="tag-dot"></span> Carbon Financial Intelligence</div>
        <h1 class="display">Karbon kaç Euro değil.<br/><span>Size kaç Euro?</span></h1>
        <p class="lead">CBAM, EU ETS ve Türkiye ETS verilerini şirketinizin ürün maliyetine, müşteri kârlılığına ve fiyatlama kararına bağlayan finansal karar katmanı.</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/karbon-maliyet-hesaplama">Karbon maliyetini hesapla</a>
          <a class="btn btn-ghost" href="#neden">Nasıl çalışır</a>
        </div>
      </div>
      <PriceStrip />
    </div>
  </section>

  <section class="container proofbar" aria-label="Platform özellikleri">
    <div><strong>Resmî / piyasa / senaryo</strong><span>verisi ayrı tutulur</span></div>
    <div><strong>Audit-ready</strong><span>kaynak ve dönem görünür</span></div>
    <div><strong>Deterministik motor</strong><span>AI hesap yapmaz</span></div>
    <div><strong>Finans odaklı</strong><span>marj ve fiyat kararı</span></div>
  </section>

  <div class="container"><DecisionPanel /></div>

  <section class="container" id="neden">
    <div class="section-head">
      <span class="eyebrow">Neden farklı</span>
      <h2 class="section-title">Uyum raporunun bittiği yerde finansal karar başlar.</h2>
    </div>
    <div class="feature-grid">
      <article class="card feature"><span>01</span><h3>Carbon P&amp;L</h3><p>Karbon maliyetini ürün bazında brüt marj, fiyat ve kârlılık etkisine çevirir.</p></article>
      <article class="card feature"><span>02</span><h3>Customer Profitability</h3><p>Hangi müşterinin karbon sonrası marjı aşağı çektiğini görün.</p></article>
      <article class="card feature"><span>03</span><h3>Break-even Carbon Price</h3><p>Bir ürünün hangi karbon fiyatından sonra zarar etmeye başladığını hesaplayın.</p></article>
      <article class="card feature"><span>04</span><h3>Scenario Engine</h3><p>€60 / €90 / €120 senaryolarında yıllık maliyet ve fiyat revizyon ihtiyacını test edin.</p></article>
      <article class="card feature"><span>05</span><h3>TR ETS → CBAM</h3><p>Türkiye’de ödenen uygun karbon bedelinin potansiyel mahsup etkisini ayrı katmanda modelleyin.</p></article>
      <article class="card feature"><span>06</span><h3>Management Pack</h3><p>Çıktıyı çevre raporu değil, CFO ve satış yönetimi için karar notuna dönüştürün.</p></article>
    </div>
  </section>

  <section class="container"><Calculator /></section>

  <section class="container sectors">
    <div class="section-head">
      <span class="eyebrow">İlk odak</span>
      <h2 class="section-title">Yüksek karbon maruziyetli ihracatçı sektörler.</h2>
      <p class="lead">İlk ürün mimarisi finansal etkinin en net ölçülebildiği sektörlere göre tasarlandı.</p>
    </div>
    <div class="sector-list">
      <a href="/cbam-fiyati" class="sector-row"><span>Demir &amp; Çelik</span><small>CBAM · ürün bazlı maliyet</small><b>→</b></a>
      <a href="/cbam-fiyati" class="sector-row"><span>Alüminyum</span><small>CBAM · marj ve teklif fiyatı</small><b>→</b></a>
      <a href="/turkiye-ets" class="sector-row"><span>Çimento</span><small>TR ETS · tesis exposure</small><b>→</b></a>
      <a href="/turkiye-ets" class="sector-row"><span>Gübre</span><small>TR ETS · enerji / proses etkisi</small><b>→</b></a>
    </div>
  </section>

  <section class="container source-section">
    <div class="source-copy"><span class="eyebrow">Güvenilirlik</span><h2 class="section-title">Her rakamın arkasında kaynak, dönem ve durum etiketi.</h2></div>
    <div class="source-card card">
      <div><span>CBAM</span><strong>European Commission</strong><small>OFFICIAL</small></div>
      <div><span>EU ETS</span><strong>Lisanslı piyasa feed'i</strong><small>MARKET</small></div>
      <div><span>TR ETS</span><strong>Resmî piyasa kaynağı</strong><small>PENDING</small></div>
      <div><span>FX</span><strong>TCMB / lisanslı sağlayıcı</strong><small>REFERENCE</small></div>
    </div>
  </section>

  <section class="container cta card">
    <div><span class="eyebrow">2027 hazırlığı</span><h2>Karbon maliyetini bütçeye girmeden önce stres testine sokun.</h2></div>
    <div class="cta-actions"><a class="btn btn-primary" href="/karbon-maliyet-hesaplama">Stres testi başlat</a><a class="btn btn-ghost" href="https://degerlet.com">Uzmanla değerlet</a></div>
  </section>
</Layout>

<style>
  .hero{padding:92px 0 36px;overflow:hidden}.hero-inner{position:relative;z-index:1}.hero-copy{max-width:1000px}.hero h1{margin:24px 0 24px}.hero h1 span{color:var(--accent)}.hero-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:30px}
  .proofbar{display:grid;grid-template-columns:repeat(4,1fr);gap:0;margin-top:28px;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.proofbar div{padding:18px 16px;border-right:1px solid var(--line)}.proofbar div:last-child{border-right:0}.proofbar strong,.proofbar span{display:block}.proofbar strong{font-size:13px}.proofbar span{color:var(--muted);font-size:11px;margin-top:4px}
  .section-head{padding:96px 0 32px}.section-head .section-title{margin:18px 0 14px}
  .feature-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.feature{padding:24px;min-height:210px}.feature>span{font-size:11px;color:var(--accent);letter-spacing:.12em}.feature h3{font-size:22px;margin:42px 0 10px}.feature p{color:var(--muted);font-size:14px;line-height:1.6}
  .sectors{padding-top:16px}.sector-list{border-top:1px solid var(--line)}.sector-row{display:grid;grid-template-columns:1.2fr 1fr auto;align-items:center;padding:22px 4px;border-bottom:1px solid var(--line)}.sector-row span{font-size:22px;font-weight:650}.sector-row small{color:var(--muted)}.sector-row b{font-size:22px;color:var(--accent)}.sector-row:hover span{color:var(--accent)}
  .source-section{display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:center;padding-top:110px}.source-copy .section-title{margin-top:18px}.source-card{padding:8px}.source-card>div{display:grid;grid-template-columns:100px 1fr auto;align-items:center;padding:17px 14px;border-bottom:1px solid var(--line)}.source-card>div:last-child{border-bottom:0}.source-card span,.source-card small{color:var(--muted);font-size:11px}.source-card small{letter-spacing:.12em}.source-card strong{font-size:14px}
  .cta{margin-top:110px;padding:42px;display:flex;align-items:flex-end;justify-content:space-between;gap:40px}.cta h2{font-size:38px;line-height:1.05;max-width:720px;margin:16px 0 0}.cta-actions{display:flex;gap:10px;flex-wrap:wrap}
  @media(max-width:900px){.proofbar{grid-template-columns:1fr 1fr}.proofbar div:nth-child(2){border-right:0}.proofbar div:nth-child(-n+2){border-bottom:1px solid var(--line)}.feature-grid{grid-template-columns:1fr 1fr}.source-section{grid-template-columns:1fr}.cta{align-items:flex-start;flex-direction:column}}
  @media(max-width:620px){.hero{padding-top:62px}.proofbar{grid-template-columns:1fr}.proofbar div{border-right:0;border-bottom:1px solid var(--line)!important}.proofbar div:last-child{border-bottom:0!important}.feature-grid{grid-template-columns:1fr}.sector-row{grid-template-columns:1fr auto}.sector-row small{grid-column:1}.source-card>div{grid-template-columns:78px 1fr}.source-card small{grid-column:2;margin-top:5px}.cta{padding:26px}.cta h2{font-size:31px}}
</style>
