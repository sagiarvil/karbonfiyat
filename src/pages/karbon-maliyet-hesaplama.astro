---
import Layout from "../layouts/Layout.astro";
import Calculator from "../components/Calculator.astro";

const schema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "Karbon Maliyet Hesaplama Aracı",
  applicationCategory: "BusinessApplication",
  operatingSystem: "All",
  description: "İhracat miktarı, gömülü emisyon, karbon kotasyonu ve ürün maliyeti parametreleriyle brüt maruziyet ve fiyat revizyon ihtiyacını hesaplayın.",
  url: "https://karbonfiyat.com/karbon-maliyet-hesaplama"
};
---
<Layout
  title="Karbon Maliyet Hesaplama | CBAM Finansal Etki"
  description="İhracat miktarı, gömülü emisyon ve karbon fiyatını girerek şirketinizin brüt karbon maruziyetini ve ürün tonu başına karbon maliyetini hesaplayın."
  canonical="/karbon-maliyet-hesaplama"
  schema={schema}
>
  <section class="container subhero">
    <span class="eyebrow">Finansal Simülasyon</span>
    <h1 class="section-title">Karbon maliyetinizi ve marj erimesini 30 saniyede görün.</h1>
    <p class="lead">
      Bu kurallı hesaplama brüt finansal maruziyetinizi ve başabaş satış fiyatı ihtiyacınızı netleştirir.
      İhracat verileriniz sunuculara iletilmez, tüm hesaplama doğrudan tarayıcınızda icra edilir.
    </p>
  </section>

  <section class="container">
    <Calculator />
  </section>
</Layout>

<style>
  .subhero {
    padding: 88px 0 16px;
  }
  .subhero h1 {
    margin: 18px 0 16px;
  }
  @media (max-width: 860px) {
    .subhero { padding-top: 64px; }
  }
</style>