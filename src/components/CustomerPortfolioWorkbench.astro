---
const sampleRows = [
  { client: "ABC Stahl GmbH", country: "Almanya", volume: 5000, sales: 860, cost: 620, emission: 1.84 },
  { client: "DEF Metalli SpA", country: "İtalya", volume: 3500, sales: 830, cost: 610, emission: 1.84 },
  { client: "XYZ Construct BV", country: "Hollanda", volume: 1500, sales: 790, cost: 640, emission: 1.84 }
];
---

<section class="portfolio-workbench" id="musteri-portfoyu">
  <div class="container">
    <div class="bench-head">
      <div>
        <span class="eyebrow">CANLI PORTFÖY KARAR MOTORU</span>
        <h2>Müşteriyi değil, sözleşmenin karbon sonrası kârını yönetin.</h2>
        <p>Müşteri hacmi, sözleşme fiyatı, üretim maliyeti ve emisyon yoğunluğunu girin. Motor her müşterinin karbon sonrası marjını ve gerekli fiyat revizyonunu ayrı hesaplar.</p>
      </div>
      <div class="bench-controls">
        <label><span>Karbon fiyatı</span><div class="compact-input"><input type="number" value="75.28" min="0" step="0.01" data-pf-price /><em>€/tCO₂</em></div></label>
        <label><span>Mahsup senaryosu</span><div class="compact-input"><input type="number" value="0" min="0" max="100" step="1" data-pf-offset /><em>%</em></div></label>
      </div>
    </div>

    <div class="portfolio-table-shell">
      <div class="table-scroll">
        <table class="portfolio-table">
          <thead>
            <tr>
              <th>Müşteri</th><th>Ülke</th><th>Hacim<br /><small>ton</small></th><th>Satış<br /><small>€/ton</small></th><th>Maliyet<br /><small>€/ton</small></th><th>Emisyon<br /><small>tCO₂/ton</small></th><th>Net karbon</th><th>Karbon sonrası marj</th><th>Fiyat revizyonu</th><th>Durum</th><th></th>
            </tr>
          </thead>
          <tbody data-pf-body>
            {sampleRows.map((row, index) => (
              <tr data-pf-row>
                <td><input type="text" value={row.client} data-field="client" aria-label={"Müşteri " + (index + 1)} /></td>
                <td><input type="text" value={row.country} data-field="country" aria-label={"Ülke " + (index + 1)} /></td>
                <td><input type="number" value={row.volume} min="0" step="100" data-field="volume" aria-label={"Tonaj " + (index + 1)} /></td>
                <td><input type="number" value={row.sales} min="0" step="1" data-field="sales" aria-label={"Satış fiyatı " + (index + 1)} /></td>
                <td><input type="number" value={row.cost} min="0" step="1" data-field="cost" aria-label={"Üretim maliyeti " + (index + 1)} /></td>
                <td><input type="number" value={row.emission} min="0" step="0.01" data-field="emission" aria-label={"Emisyon yoğunluğu " + (index + 1)} /></td>
                <td class="metric" data-result="carbon">—</td>
                <td class="metric" data-result="margin">—</td>
                <td class="metric" data-result="revision">—</td>
                <td><span class="risk-chip" data-result="risk">—</span></td>
                <td><button class="remove-row" type="button" data-remove-row aria-label="Satırı sil">×</button></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="portfolio-toolbar">
        <button class="btn btn-secondary" type="button" data-add-row>Müşteri Ekle</button>
        <button class="btn btn-secondary" type="button" data-save-portfolio>Portföyü Kaydet</button>
        <button class="btn btn-secondary" type="button" data-import-portfolio>CSV İçe Aktar</button>
        <input type="file" accept=".csv,text/csv" data-import-file hidden />
        <button class="btn btn-secondary" type="button" data-export-portfolio>CSV Dışa Aktar</button>
      </div>
    </div>

    <div class="portfolio-summary">
      <article><span>Toplam ciro</span><strong data-pf-total="revenue">€0</strong></article>
      <article><span>Net karbon maliyeti</span><strong data-pf-total="carbon">€0</strong></article>
      <article><span>Portföy marjı · önce</span><strong data-pf-total="before">%0</strong></article>
      <article><span>Portföy marjı · sonra</span><strong data-pf-total="after">%0</strong></article>
      <article><span>Kritik müşteri</span><strong data-pf-total="critical">0</strong></article>
    </div>

    <div class="portfolio-takeaway"><span>YÖNETİM ÖZETİ</span><strong data-pf-takeaway>Portföy hesaplanıyor.</strong></div>
    <div class="portfolio-note" data-pf-message aria-live="polite"></div>
  </div>
</section>

<script>
  import { computePortfolioCore } from "../lib/financial-core.mjs";

  const root = document.querySelector("#musteri-portfoyu");

  if (root) {
    const body = root.querySelector("[data-pf-body]");
    const priceInput = root.querySelector("[data-pf-price]");
    const offsetInput = root.querySelector("[data-pf-offset]");
    const message = root.querySelector("[data-pf-message]");
    const STORAGE_KEY = "karbonfiyat_portfolio_v1";

    const eur0 = new Intl.NumberFormat("tr-TR", { style: "currency", currency: "EUR", maximumFractionDigits: 0 });
    const pct1 = new Intl.NumberFormat("tr-TR", { minimumFractionDigits: 1, maximumFractionDigits: 1 });

    const setMessage = (text) => {
      if (!message) return;
      message.textContent = text;
      setTimeout(() => {
        if (message.textContent === text) message.textContent = "";
      }, 4500);
    };

    const makeRow = (data = {}) => {
      const tr = document.createElement("tr");
      tr.dataset.pfRow = "";
      tr.innerHTML =
        '<td><input type="text" data-field="client" aria-label="Müşteri" /></td>' +
        '<td><input type="text" data-field="country" aria-label="Ülke" /></td>' +
        '<td><input type="number" min="0.01" step="100" data-field="volume" /></td>' +
        '<td><input type="number" min="0.01" step="1" data-field="sales" /></td>' +
        '<td><input type="number" min="0" step="1" data-field="cost" /></td>' +
        '<td><input type="number" min="0" step="0.01" data-field="emission" /></td>' +
        '<td class="metric" data-result="carbon">—</td>' +
        '<td class="metric" data-result="margin">—</td>' +
        '<td class="metric" data-result="revision">—</td>' +
        '<td><span class="risk-chip" data-result="risk">—</span></td>' +
        '<td><button class="remove-row" type="button" data-remove-row aria-label="Satırı sil">×</button></td>';

      ["client", "country", "volume", "sales", "cost", "emission"].forEach((key) => {
        const input = tr.querySelector('[data-field="' + key + '"]');
        if (input) input.value = data[key] ?? (key === "emission" ? "1.84" : "");
      });
      return tr;
    };

    const rowsData = () => Array.from(body.querySelectorAll("[data-pf-row]")).map((row, index) => {
      const get = (key) => row.querySelector('[data-field="' + key + '"]')?.value ?? "";
      return {
        id: "C" + (index + 1),
        client: String(get("client")).trim() || "İsimsiz müşteri",
        country: String(get("country")).trim(),
        volume: Number.parseFloat(get("volume")),
        sales: Number.parseFloat(get("sales")),
        cost: Number.parseFloat(get("cost")),
        emission: Number.parseFloat(get("emission"))
      };
    });

    const calculate = ({ quiet = false } = {}) => {
      try {
        const carbonPrice = Number.parseFloat(priceInput?.value ?? "");
        const offsetPct = Number.parseFloat(offsetInput?.value ?? "");
        const customers = rowsData();
        const result = computePortfolioCore(customers, carbonPrice, offsetPct);

        result.evaluations.forEach((evaluation, index) => {
          const row = body.querySelectorAll("[data-pf-row]")[index];
          if (!row) return;
          const carbonOut = row.querySelector('[data-result="carbon"]');
          const marginOut = row.querySelector('[data-result="margin"]');
          const revisionOut = row.querySelector('[data-result="revision"]');
          const riskOut = row.querySelector('[data-result="risk"]');

          if (carbonOut) carbonOut.textContent = eur0.format(evaluation.netCarbon);
          if (marginOut) marginOut.textContent = "%" + pct1.format(evaluation.marginAfter);
          if (revisionOut) revisionOut.textContent = "%" + pct1.format(evaluation.revisionPct);
          if (riskOut) {
            const mapping = {
              CRITICAL: ["KRİTİK", "critical"],
              REVISION: ["REVİZYON", "warning"],
              HEALTHY: ["KORUNABİLİR", "healthy"]
            };
            const [label, level] = mapping[evaluation.risk] || [evaluation.risk, "healthy"];
            riskOut.textContent = label;
            riskOut.dataset.level = level;
          }
        });

        const total = (key) => root.querySelector('[data-pf-total="' + key + '"]');
        if (total("revenue")) total("revenue").textContent = eur0.format(result.totalRevenue);
        if (total("carbon")) total("carbon").textContent = eur0.format(result.totalNetCarbon);
        if (total("before")) total("before").textContent = "%" + pct1.format(result.marginBefore);
        if (total("after")) total("after").textContent = "%" + pct1.format(result.marginAfter);
        if (total("critical")) total("critical").textContent = String(result.criticalCount);

        const takeaway = root.querySelector("[data-pf-takeaway]");
        if (takeaway) {
          takeaway.textContent = result.criticalCount > 0
            ? customers.length + " müşteriden " + result.criticalCount + " tanesi karbon sonrası kritik marj bölgesinde. Bu sözleşmeler için fiyat revizyonu veya hacim kararı önceliklendirilmeli."
            : "Portföyde kritik zarar bölgesinde müşteri yok. Karbon sonrası ortalama portföy marjı %" + pct1.format(result.marginAfter) + ".";
        }

        return {
          carbonPrice: result.carbonPrice,
          offsetPct: result.offsetPct,
          totalRevenue: result.totalRevenue,
          totalNetCarbon: result.totalNetCarbon,
          marginBefore: result.marginBefore,
          marginAfter: result.marginAfter,
          criticalCount: result.criticalCount,
          customers,
          savedAt: new Date().toISOString()
        };
      } catch (error) {
        if (!quiet) setMessage("Portföy hesaplaması reddedildi: " + (error?.message || "Geçersiz veri."));
        return null;
      }
    };

    const bind = () => {
      body.querySelectorAll("input").forEach((input) => {
        if (!input.dataset.bound) {
          input.dataset.bound = "1";
          input.addEventListener("input", () => calculate({ quiet: true }));
        }
      });
      body.querySelectorAll("[data-remove-row]").forEach((button) => {
        if (!button.dataset.bound) {
          button.dataset.bound = "1";
          button.addEventListener("click", () => {
            if (body.querySelectorAll("[data-pf-row]").length <= 1) return;
            button.closest("[data-pf-row]")?.remove();
            calculate({ quiet: true });
          });
        }
      });
    };

    root.querySelector("[data-add-row]")?.addEventListener("click", () => {
      body.appendChild(makeRow({ volume: 1000, sales: 850, cost: 620, emission: 1.84 }));
      bind();
      calculate({ quiet: true });
    });

    [priceInput, offsetInput].forEach((input) => input?.addEventListener("input", () => calculate({ quiet: true })));

    root.querySelector("[data-save-portfolio]")?.addEventListener("click", () => {
      const data = calculate();
      if (!data) return;
      localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
      setMessage("Portföy bu cihazda kaydedildi. Sunucuya veri gönderilmedi.");
    });

    const importButton = root.querySelector("[data-import-portfolio]");
    const importFile = root.querySelector("[data-import-file]");
    importButton?.addEventListener("click", () => importFile?.click());

    importFile?.addEventListener("change", async () => {
      const file = importFile.files?.[0];
      if (!file) return;

      try {
        const text = await file.text();
        const lines = text.split(/\r?\n/).filter((line) => line.trim());
        if (lines.length < 2) throw new Error("CSV içinde veri satırı bulunamadı.");

        const delimiter = lines[0].includes(";") ? ";" : ",";
        const parseLine = (line) => {
          const out = [];
          let current = "";
          let quoted = false;
          for (let i = 0; i < line.length; i++) {
            const ch = line[i];
            if (ch === '"') {
              if (quoted && line[i + 1] === '"') {
                current += '"';
                i++;
              } else {
                quoted = !quoted;
              }
            } else if (ch === delimiter && !quoted) {
              out.push(current.trim());
              current = "";
            } else {
              current += ch;
            }
          }
          out.push(current.trim());
          return out;
        };

        const dataRows = lines.slice(1)
          .map(parseLine)
          .filter((cols) => cols.length >= 6 && cols[0] && cols[0] !== "Karbon fiyatı");

        if (!dataRows.length) throw new Error("Beklenen 6 kolonlu müşteri verisi bulunamadı.");

        body.innerHTML = "";
        dataRows.slice(0, 100).forEach((cols) => {
          body.appendChild(makeRow({
            client: cols[0],
            country: cols[1],
            volume: cols[2],
            sales: cols[3],
            cost: cols[4],
            emission: cols[5]
          }));
        });

        bind();
        if (!calculate()) throw new Error("CSV verilerinden en az biri geçersiz.");
        setMessage(dataRows.length + " müşteri CSV'den içe aktarıldı.");
      } catch (error) {
        setMessage("CSV içe aktarılamadı: " + (error?.message || "format hatası"));
      } finally {
        importFile.value = "";
      }
    });

    root.querySelector("[data-export-portfolio]")?.addEventListener("click", () => {
      const data = calculate();
      if (!data) return;
      const rows = [["Müşteri", "Ülke", "Hacim ton", "Satış €/ton", "Maliyet €/ton", "Emisyon tCO2/ton"]];
      data.customers.forEach((customer) => rows.push([customer.client, customer.country, customer.volume, customer.sales, customer.cost, customer.emission]));
      rows.push([]);
      rows.push(["Karbon fiyatı", data.carbonPrice]);
      rows.push(["Mahsup %", data.offsetPct]);
      rows.push(["Toplam ciro €", data.totalRevenue]);
      rows.push(["Net karbon maliyeti €", data.totalNetCarbon]);
      rows.push(["Portföy marjı önce %", data.marginBefore]);
      rows.push(["Portföy marjı sonra %", data.marginAfter]);
      rows.push(["Kritik müşteri", data.criticalCount]);

      const csv = rows.map((row) => row.map((cell) => '"' + String(cell ?? "").replaceAll('"', '""') + '"').join(";")).join("\n");
      const blob = new Blob(["\ufeff" + csv], { type: "text/csv;charset=utf-8" });
      const url = URL.createObjectURL(blob);
      const anchor = document.createElement("a");
      anchor.href = url;
      anchor.download = "karbonfiyat-musteri-portfoyu.csv";
      document.body.appendChild(anchor);
      anchor.click();
      anchor.remove();
      URL.revokeObjectURL(url);
      setMessage("Müşteri portföyü CSV olarak indirildi.");
    });

    try {
      const saved = JSON.parse(localStorage.getItem(STORAGE_KEY) || "null");
      if (saved?.customers?.length) {
        body.innerHTML = "";
        saved.customers.forEach((customer) => body.appendChild(makeRow(customer)));
        if (priceInput && saved.carbonPrice !== undefined) priceInput.value = String(saved.carbonPrice);
        if (offsetInput && saved.offsetPct !== undefined) offsetInput.value = String(saved.offsetPct);
      }
    } catch {}

    bind();
    calculate({ quiet: true });
  }
</script>

<style>
  .portfolio-workbench { padding:30px 0 76px; }
  .bench-head { display:flex; justify-content:space-between; align-items:flex-end; gap:28px; margin-bottom:22px; }
  .bench-head > div:first-child { max-width:760px; }
  .bench-head h2 { margin:12px 0; color:#fff; font-size:clamp(32px,4vw,48px); line-height:1.04; }
  .bench-head p { margin:0; color:var(--text-secondary); line-height:1.65; }
  .bench-controls { display:grid; grid-template-columns:1fr 1fr; gap:8px; min-width:360px; }
  .bench-controls label > span { display:block; color:var(--text-muted); font-size:9px; margin-bottom:6px; }
  .compact-input { min-height:43px; display:flex; align-items:center; border:1px solid var(--border-soft); border-radius:10px; background:#0d1011; padding-right:10px; }
  .compact-input input { width:100%; min-width:0; border:0; background:transparent; color:#fff; padding:0 10px; outline:0; }
  .compact-input em { color:var(--text-muted); font-style:normal; font-size:9px; white-space:nowrap; }
  .portfolio-table-shell { border:1px solid var(--border-soft); border-radius:18px; overflow:hidden; background:#101313; }
  .table-scroll { width:100%; overflow-x:auto; }
  .portfolio-table { width:100%; min-width:1180px; border-collapse:collapse; }
  .portfolio-table th { padding:12px 10px; text-align:left; color:var(--text-muted); font-size:9px; letter-spacing:.05em; text-transform:uppercase; border-bottom:1px solid var(--border-soft); background:#0b0e0f; }
  .portfolio-table th small { font-size:8px; color:var(--text-muted); font-weight:400; text-transform:none; }
  .portfolio-table td { padding:9px 8px; border-bottom:1px solid rgba(255,255,255,.04); }
  .portfolio-table tbody tr:last-child td { border-bottom:0; }
  .portfolio-table input { width:100%; min-width:74px; min-height:38px; border:1px solid transparent; border-radius:8px; background:#0b0e0f; color:var(--text-primary); padding:0 9px; outline:0; font-size:11px; }
  .portfolio-table input:focus { border-color:var(--border-medium); }
  .metric { color:var(--text-primary); font-size:11px; white-space:nowrap; font-weight:650; }
  .risk-chip { display:inline-flex; min-height:24px; align-items:center; padding:0 8px; border:1px solid var(--border-soft); border-radius:999px; color:var(--text-secondary); font-size:8px; font-weight:800; letter-spacing:.06em; }
  .risk-chip[data-level="warning"] { color:#FBBF24; border-color:rgba(217,119,6,.35); }
  .risk-chip[data-level="critical"] { color:#F87171; border-color:rgba(220,38,38,.42); }
  .risk-chip[data-level="healthy"] { color:#86EFAC; border-color:rgba(22,163,74,.32); }
  .remove-row { width:28px; height:28px; border:1px solid var(--border-soft); border-radius:8px; background:transparent; color:var(--text-muted); cursor:pointer; }
  .remove-row:hover { color:#fff; border-color:rgba(220,38,38,.4); }
  .portfolio-toolbar { display:flex; gap:8px; flex-wrap:wrap; padding:12px; border-top:1px solid var(--border-soft); background:#0b0e0f; }
  .portfolio-toolbar .btn { min-height:38px; font-size:10px; }
  .portfolio-summary { display:grid; grid-template-columns:repeat(5,1fr); gap:8px; margin-top:12px; }
  .portfolio-summary article { padding:15px; border:1px solid var(--border-soft); border-radius:12px; background:#101313; }
  .portfolio-summary span,.portfolio-summary strong { display:block; }
  .portfolio-summary span { color:var(--text-muted); font-size:8px; letter-spacing:.05em; text-transform:uppercase; }
  .portfolio-summary strong { margin-top:9px; color:#fff; font-size:17px; }
  .portfolio-takeaway { margin-top:10px; padding:16px 18px; border:1px solid var(--border-medium); border-radius:12px; background:#0c0f10; }
  .portfolio-takeaway span,.portfolio-takeaway strong { display:block; }
  .portfolio-takeaway span { color:var(--text-muted); font-size:8px; letter-spacing:.1em; }
  .portfolio-takeaway strong { margin-top:7px; color:var(--text-primary); font-size:13px; line-height:1.55; }
  .portfolio-note { min-height:20px; margin-top:8px; color:var(--text-muted); font-size:10px; }
  @media(max-width:900px) { .bench-head { align-items:flex-start; flex-direction:column; } .bench-controls { width:100%; min-width:0; } .portfolio-summary { grid-template-columns:repeat(2,1fr); } }
  @media(max-width:560px) { .bench-controls,.portfolio-summary { grid-template-columns:1fr; } .portfolio-toolbar .btn { width:100%; } }
</style>
