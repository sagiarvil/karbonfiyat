---
const cbamPrice = 75.28;
const cbamPeriod = "2026 Q2";
const cbamPublished = "6 Temmuz 2026";
const cbamNext = "5 Ekim 2026";
const carbonCreditsWidgetHtml = `<div id="carbon-prices"><script type="text/javascript" src="https://carboncredits.com/live-carbon-prices/index.js.php" async></script></div>`;
---

<section class="market-terminal" id="canli-karbon-fiyatlari">
  <div class="container">
    <div class="terminal-head">
      <div>
        <span class="eyebrow">CARBON MARKET TERMINAL</span>
        <h2>Karbon fiyatını izlemeyin. Finansal etkisini yönetin.</h2>
        <p>
          Resmî CBAM fiyatı, EUA piyasa görünümü ve Türkiye ETS statüsü tek ekranda.
          Ardından bu fiyatı şirketinizin tonajına, emisyon yoğunluğuna ve satış büyüklüğüne çevirin.
        </p>
      </div>
      <div class="terminal-status">
        <span class="pulse" aria-hidden="true"></span>
        <div>
          <strong>VERİ MERKEZİ AKTİF</strong>
          <small>Son kontrol: 22 Eylül 2026</small>
        </div>
      </div>
    </div>

    <div class="market-strip">
      <article class="market-card official-card">
        <div class="market-card-top">
          <div>
            <span class="market-code">CBAM</span>
            <span class="status-pill official">RESMÎ</span>
          </div>
          <span class="market-type">AB sertifika fiyatı</span>
        </div>
        <div class="market-value">
          <strong>€{cbamPrice.toFixed(2).replace(".", ",")}</strong>
          <span>/ tCO₂</span>
        </div>
        <div class="market-meta">
          <div><span>Dönem</span><strong>{cbamPeriod}</strong></div>
          <div><span>Yayın</span><strong>{cbamPublished}</strong></div>
          <div><span>Sonraki</span><strong>{cbamNext}</strong></div>
        </div>
        <p>
          Avrupa Komisyonu tarafından yayımlanan 2026 Q2 resmî CBAM sertifika fiyatı.
        </p>
        <a
          class="source-link"
          href="https://taxation-customs.ec.europa.eu/carbon-border-adjustment-mechanism/price-cbam-certificates_en"
          target="_blank"
          rel="noopener"
        >
          Avrupa Komisyonu kaynağı ↗
        </a>
      </article>

      <article class="market-card live-card">
        <div class="market-card-top">
          <div>
            <span class="market-code">CANLI KARBON PİYASALARI</span>
            <span class="status-pill market">CANLI</span>
          </div>
          <span class="market-type">EU ETS dahil küresel karbon piyasaları</span>
        </div>

        <div class="live-widget-shell carboncredits-shell">
          <div class="carboncredits-embed" set:html={carbonCreditsWidgetHtml}></div>
          <noscript>
            <p class="widget-fallback">Canlı karbon piyasası görünümü için JavaScript etkin olmalıdır.</p>
          </noscript>
        </div>

        <div class="data-note">
          <span class="data-dot" aria-hidden="true"></span>
          <p>
            Canlı fiyat paneli <strong>CarbonCredits.com</strong> tarafından yayınlanır ve EU ETS dahil birden çok
            compliance / carbon market referansını gösterir. KarbonFiyat bu dış piyasa verisini resmî CBAM fiyatından
            ayrı tutar; finansal karar motorunda kullanılan veri kaynağı açıkça etiketlenir.
          </p>
        </div>

        <a
          class="source-link market-source"
          href="https://carboncredits.com/carbon-prices-today/"
          target="_blank"
          rel="noopener"
        >
          Canlı piyasa kaynağı ↗
        </a>
      </article>

      <article class="market-card tr-card">
        <div class="market-card-top">
          <div>
            <span class="market-code">TÜRKİYE ETS</span>
            <span class="status-pill pilot">PİLOT</span>
          </div>
          <span class="market-type">Ulusal karbon piyasası</span>
        </div>
        <div class="empty-price">
          <strong>Henüz fiyat oluşmadı</strong>
          <span>Resmî piyasa fiyatı yayınlanmadı</span>
        </div>
        <div class="market-meta">
          <div><span>Durum</span><strong>Pilot / hazırlık</strong></div>
          <div><span>Modelleme</span><strong>Senaryo ile</strong></div>
          <div><span>Kaynak</span><strong>Resmî gelişmeler</strong></div>
        </div>
        <p>
          Piyasa fiyatı oluşana kadar burada tahmin “canlı fiyat” olarak gösterilmez.
          Finansal modelleme yalnızca açıkça etiketlenmiş senaryo fiyatlarıyla yapılır.
        </p>
        <a class="source-link" href="/turkiye-ets">Türkiye ETS görünümü →</a>
      </article>
    </div>

    <div class="impact-engine">
      <div class="engine-copy">
        <span class="eyebrow">FİYAT → MALİYET → MARJ</span>
        <h3>Karbon fiyatını şirketinize çevirin.</h3>
        <p>
          Bu motor piyasa yorumlamaz; deterministik hesap yapar. İhracat tonajı, gömülü emisyon yoğunluğu
          ve satış büyüklüğünüz üzerinden karbon maliyetinin finansal baskısını saniyeler içinde gösterir.
        </p>

        <div class="method-tags">
          <span>AI’sız hesaplama</span>
          <span>Formül görünür</span>
          <span>Kaynak ayrıştırılmış</span>
          <span>Senaryo kontrollü</span>
        </div>
      </div>

      <div class="engine-panel" data-carbon-engine data-cbam-price={cbamPrice}>
        <div class="input-grid">
          <label>
            <span>Yıllık AB ihracatı</span>
            <div class="input-wrap">
              <input type="number" min="0" step="100" value="1000" data-export-tonnes />
              <em>ton</em>
            </div>
          </label>

          <label>
            <span>Gömülü emisyon yoğunluğu</span>
            <div class="input-wrap">
              <input type="number" min="0" step="0.01" value="1.80" data-intensity />
              <em>tCO₂ / ton</em>
            </div>
          </label>

          <label>
            <span>Yıllık AB satış tutarı</span>
            <div class="input-wrap">
              <input type="number" min="0" step="10000" value="2500000" data-sales />
              <em>€</em>
            </div>
          </label>

          <label>
            <span>Karbon fiyatı</span>
            <div class="input-wrap">
              <input type="number" min="0" step="0.01" value={cbamPrice} data-carbon-price />
              <em>€/tCO₂</em>
            </div>
          </label>
        </div>

        <div class="preset-row">
          <button type="button" class="preset active" data-price-preset={cbamPrice}>CBAM {cbamPeriod}</button>
          <button type="button" class="preset" data-price-preset="90">€90 senaryo</button>
          <button type="button" class="preset" data-price-preset="110">€110 stres</button>
          <button type="button" class="preset" data-price-preset="150">€150 yüksek stres</button>
        </div>

        <div class="results-grid">
          <div class="result primary">
            <span>Toplam gömülü emisyon</span>
            <strong data-result-emissions>1.800 tCO₂</strong>
          </div>
          <div class="result">
            <span>Yıllık karbon maliyeti</span>
            <strong data-result-cost>€135.504</strong>
          </div>
          <div class="result">
            <span>İhraç tonuna maliyet</span>
            <strong data-result-per-ton>€135,50</strong>
          </div>
          <div class="result danger">
            <span>Satış gelirine baskı</span>
            <strong data-result-sales-impact>%5,42</strong>
          </div>
        </div>

        <div class="formula">
          <span>FORMÜL</span>
          <code>İhracat tonajı × tCO₂/ton × karbon fiyatı = yıllık karbon maliyeti</code>
        </div>
      </div>
    </div>

    <div class="intelligence-grid">
      <article>
        <span class="intel-no">01</span>
        <h4>Resmî fiyatı piyasa fiyatından ayırıyoruz.</h4>
        <p>
          CBAM sertifika fiyatı ile EUA vadeli piyasa kotasyonu aynı şey değildir.
          Sistem bunları tek rakam gibi sunmaz.
        </p>
      </article>
      <article>
        <span class="intel-no">02</span>
        <h4>Fiyat değişimini işletme kararına bağlıyoruz.</h4>
        <p>
          “Karbon €85 oldu” bilgisini; maliyet, marj, satış fiyatı ve müşteri kârlılığına çevirmek asıl üründür.
        </p>
      </article>
      <article>
        <span class="intel-no">03</span>
        <h4>Olmayan veriyi üretmiyoruz.</h4>
        <p>
          Türkiye ETS gibi resmî fiyatı oluşmamış piyasalarda tahmini rakamı canlı fiyat gibi göstermiyoruz.
        </p>
      </article>
      <article>
        <span class="intel-no">04</span>
        <h4>Her veriye kaynak ve statü ekliyoruz.</h4>
        <p>
          Resmî, piyasa, pilot ve senaryo fiyatları görsel olarak ayrılır; karar katmanı hangi veriyi kullandığını bilir.
        </p>
      </article>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const root = document.querySelector("[data-carbon-engine]");
    if (!root) return;

    const exportInput = root.querySelector("[data-export-tonnes]");
    const intensityInput = root.querySelector("[data-intensity]");
    const salesInput = root.querySelector("[data-sales]");
    const priceInput = root.querySelector("[data-carbon-price]");

    const emissionsOut = root.querySelector("[data-result-emissions]");
    const costOut = root.querySelector("[data-result-cost]");
    const perTonOut = root.querySelector("[data-result-per-ton]");
    const impactOut = root.querySelector("[data-result-sales-impact]");

    const euro0 = new Intl.NumberFormat("tr-TR", {
      style: "currency",
      currency: "EUR",
      maximumFractionDigits: 0
    });

    const euro2 = new Intl.NumberFormat("tr-TR", {
      style: "currency",
      currency: "EUR",
      minimumFractionDigits: 2,
      maximumFractionDigits: 2
    });

    const num0 = new Intl.NumberFormat("tr-TR", {
      maximumFractionDigits: 0
    });

    const pct2 = new Intl.NumberFormat("tr-TR", {
      minimumFractionDigits: 2,
      maximumFractionDigits: 2
    });

    const value = (el) => {
      const parsed = Number.parseFloat(el?.value || "0");
      return Number.isFinite(parsed) ? Math.max(0, parsed) : 0;
    };

    const calculate = () => {
      const tonnes = value(exportInput);
      const intensity = value(intensityInput);
      const sales = value(salesInput);
      const price = value(priceInput);

      const emissions = tonnes * intensity;
      const cost = emissions * price;
      const perTon = tonnes > 0 ? cost / tonnes : 0;
      const impact = sales > 0 ? (cost / sales) * 100 : 0;

      if (emissionsOut) emissionsOut.textContent = num0.format(emissions) + " tCO₂";
      if (costOut) costOut.textContent = euro0.format(cost);
      if (perTonOut) perTonOut.textContent = euro2.format(perTon);
      if (impactOut) impactOut.textContent = "%" + pct2.format(impact);
    };

    [exportInput, intensityInput, salesInput, priceInput].forEach((input) => {
      input?.addEventListener("input", () => {
        root.querySelectorAll("[data-price-preset]").forEach((button) => button.classList.remove("active"));
        calculate();
      });
    });

    root.querySelectorAll("[data-price-preset]").forEach((button) => {
      button.addEventListener("click", () => {
        const preset = Number.parseFloat(button.dataset.pricePreset || "0");
        if (priceInput && Number.isFinite(preset)) priceInput.value = String(preset);
        root.querySelectorAll("[data-price-preset]").forEach((item) => item.classList.remove("active"));
        button.classList.add("active");
        calculate();
      });
    });

    calculate();
  })();
</script>

