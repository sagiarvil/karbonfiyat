---
import Layout from '../layouts/Layout.astro';
import Calculator from '../components/Calculator.astro';
---
<Layout title="Karbon Maliyet Hesaplama | CBAM Finansal Etki" description="İhracat miktarı, gömülü emisyon ve karbon fiyatını girerek şirketinizin brüt karbon maruziyetini ve ürün tonu başına karbon maliyetini hesaplayın." canonical="/karbon-maliyet-hesaplama">
  <section class="container subhero"><span class="eyebrow">Hesaplama</span><h1 class="section-title">Karbon maliyetinizi 30 saniyede görün.</h1><p class="lead">Bu hızlı hesap, brüt finansal maruziyeti gösterir. Ücretsiz tahsisat, doğrulama, mahsup ve ürün bazlı mevzuat düzeltmeleri detaylı analizde ayrıca uygulanır.</p></section>
  <section class="container"><Calculator /></section>
</Layout>
<style>.subhero{padding:90px 0 12px}.subhero h1{margin:18px 0}</style>
