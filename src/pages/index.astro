---
import Layout from "../layouts/Layout.astro";
import LossHeroCalculator from "../components/LossHeroCalculator.astro";
import RegulatoryTimelineStrip from "../components/RegulatoryTimelineStrip.astro";
import ProductFunnelLadder from "../components/ProductFunnelLadder.astro";
import InteractiveEngineConsole from "../components/InteractiveEngineConsole.astro";
import ExecutiveSampleOutput from "../components/ExecutiveSampleOutput.astro";
import AuthorityTrustStrip from "../components/AuthorityTrustStrip.astro";
import LeadOrderModal from "../components/LeadOrderModal.astro";
import { seoPages } from "../data/seo";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "KarbonFiyat Carbon Financial Intelligence",
    url: "https://karbonfiyat.com",
    applicationCategory: "BusinessApplication",
    operatingSystem: "Web",
    offers: {
      "@type": "Offer",
      price: "4900",
      priceCurrency: "TRY",
      name: "CBAM Ön Maliyet Analiz Raporu"
    },
    description: "AB SKDM (CBAM) ve Türkiye ETS maliyetlerini şirket bilançosuna, ürün maliyetine ve brüt marj kaybına çeviren finansal karar sistemi."
  },
  {
    "@context": "https://schema.org",
    "@type": "Person",
    name: "Barış Bağırlar",
    url: "https://www.linkedin.com/in/barisbagirlar/",
    sameAs: [
      "https://www.linkedin.com/in/barisbagirlar/"
    ],
    jobTitle: "Kurumsal Karbon Ayak İzi Hesaplama Mentörü & SKDM Modelleme Lideri",
    description: "Tarımkon-Uluslararası Tarım ve Gıda Konfederasyonu Danışma Kurulu Üyesi, Gaziantep Üniversitesi TS EN ISO 14064-1 Kurumsal Karbon Ayak İzi Hesaplama Mentörü.",
    affiliation: [
      {
        "@type": "Organization",
        name: "Tarımkon - Uluslararası Tarım ve Gıda Konfederasyonu",
        url: "https://tarimkon.org"
      },
      {
        "@type": "EducationalOrganization",
        name: "Gaziantep Üniversitesi"
      }
    ],
    knowsAbout: [
      "TS EN ISO 14064-1",
      "AB SKDM (CBAM)",
      "Türkiye ETS",
      "Kurumsal Karbon Ayak İzi",
      "Carbon Financial Intelligence"
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "KarbonFiyat",
    url: "https://karbonfiyat.com",
    logo: "https://karbonfiyat.com/logo/karbonfiyat-logo.png",
    founder: {
      "@type": "Person",
      name: "Barış Bağırlar",
      url: "https://www.linkedin.com/in/barisbagirlar/"
    },
    description: "Karbon fiyatını şirket maliyeti, marj ve fiyatlama kararına çeviren Carbon Financial Intelligence platformu."
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "KarbonFiyat",
    url: "https://karbonfiyat.com"
  }
];
---

<Layout
  title="KarbonFiyat · SKDM & CBAM Karbon Maliyet ve Marj Kaybı Hesaplama"
  description="AB'ye ihracat yapan Türk sanayicileri için SKDM (CBAM) ve TR-ETS karbon maliyetini, brüt marj kaybını ve koruyucu fiyat revizyonunu hesaplayan finansal karar sistemi."
  canonical={seoPages.home.canonical}
  schema={schema}
>
  <!-- 1. & 2. Bölüm: Hero + Anlık Kayıp Hesaplayıcısı & Kilitli Teaser Bloğu -->
  <LossHeroCalculator />

  <!-- 3. Bölüm: "Neden Şimdi?" Yasal Gerçeklik Şeridi -->
  <RegulatoryTimelineStrip />

  <!-- 4. Bölüm: Ürün Merdiveni (Funnel: 0 TL -> 4.900 TL -> 19.900 TL -> Monitör) -->
  <ProductFunnelLadder />

  <!-- 4.1 Bölüm: Aktif Endüstriyel Karar Motorları (Motor 02, Motor 03, Motor 04) -->
  <InteractiveEngineConsole />

  <!-- 5. Bölüm: Örnek CFO Çıktı Önizlemesi (Yönetim Kurulu Karar Tablosu) -->
  <ExecutiveSampleOutput />

  <!-- 6. Bölüm: Hofstede Uyumlu Güven & Dinamik Mevzuat Şeridi -->
  <AuthorityTrustStrip />

  <!-- 7. Bölüm: Kapanış Başvuru & 4.900 TL Talep Bloğu -->
  <LeadOrderModal />
</Layout>