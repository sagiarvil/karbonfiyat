---
import { footerColumns } from "../data/navigation";
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-col brand-col">
      <a class="footer-brand" href="/" aria-label="KarbonFiyat ana sayfa">
        <span class="footer-brand-mark" aria-hidden="true">
          <img
            src="/logo/karbonfiyat-logo.png"
            alt=""
            class="footer-logo-img"
            width="38"
            height="38"
            loading="lazy"
            decoding="async"
          />
        </span>
        <span class="footer-brand-text">karbonfiyat</span>
      </a>
      <p class="brand-desc">
        Karbon fiyatını finansal karara çeviren Carbon Financial Intelligence platformu.
      </p>
    </div>

    {footerColumns.map(col => (
      <div class="footer-col">
        <strong class="col-title">{col.title}</strong>
        <nav class="col-links" aria-label={col.title + " linkleri"}>
          {col.links.map(link => {
            const isExt = link.href.startsWith("http");
            return (
              <a
                href={link.href}
                target={isExt ? "_blank" : undefined}
                rel={isExt ? "noopener" : undefined}
              >
                {link.label}
              </a>
            );
          })}
        </nav>
      </div>
    ))}
  </div>

  <div class="container footer-bottom">
    <span class="sub-copy mono">© {year} KarbonFiyat</span>
    <span class="sub-notice">
      Resmî, piyasa, tahmin ve kullanıcı senaryosu verileri ayrı statülerde gösterilir.
    </span>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border-soft);
    margin-top: 120px;
    padding: 64px 0 32px;
    background: #0A0C0F;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.35fr 1fr 1fr 1fr;
    gap: 36px;
  }
  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--text-primary);
    font-size: 20px;
    font-weight: 750;
    letter-spacing: -0.035em;
    text-decoration: none;
  }
  .footer-brand-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 12px;
    background: linear-gradient(135deg, rgba(43, 92, 230, 0.22) 0%, rgba(14, 18, 23, 0.95) 100%);
    border: 1px solid rgba(96, 165, 250, 0.45);
    box-shadow: 0 0 16px rgba(43, 92, 230, 0.28), inset 0 1px 0 rgba(255, 255, 255, 0.2);
    flex-shrink: 0;
    transition: border-color 180ms ease, background 180ms ease, transform 180ms cubic-bezier(.2,.8,.2,1);
  }
  .footer-logo-img {
    height: 32px;
    width: 32px;
    display: block;
    object-fit: contain;
    filter: drop-shadow(0 0 4px rgba(255, 255, 255, 0.8)) drop-shadow(0 0 10px rgba(59, 130, 246, 0.6));
  }
  .footer-brand-text {
    color: #F3F4F6;
    letter-spacing: -0.035em;
    font-size: 19px;
  }
  .footer-brand:hover .footer-brand-mark {
    border-color: rgba(96, 165, 250, 0.7);
    box-shadow: 0 0 22px rgba(59, 130, 246, 0.45), inset 0 1px 0 rgba(255, 255, 255, 0.35);
    transform: translateY(-1px);
  }
  .brand-desc {
    color: var(--text-secondary);
    font-size: 14px;
    line-height: 1.6;
    margin: 0;
    max-width: 290px;
  }
  .col-title {
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-primary);
    font-weight: 650;
  }
  .col-links {
    display: flex;
    flex-direction: column;
    gap: 9px;
  }
  .col-links a {
    color: var(--text-secondary);
    font-size: 14px;
    transition: color 150ms ease;
  }
  .col-links a:hover {
    color: var(--text-primary);
  }
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    padding-top: 40px;
    margin-top: 48px;
    border-top: 1px solid var(--border-soft);
    font-size: 12px;
  }
  .sub-copy {
    font-size: 12px;
    color: var(--text-primary);
    font-weight: 550;
  }
  .sub-notice {
    color: var(--text-secondary);
  }

  @media (max-width: 860px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 32px;
    }
    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }
  }
  @media (max-width: 520px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>