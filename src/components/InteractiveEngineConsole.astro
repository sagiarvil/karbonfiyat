---
import { OFFICIAL_GTIP_DATABASE } from "../lib/cbam-report-engine";
import { DEFAULT_SAMPLE_PORTFOLIO } from "../lib/portfolio-decision-engine";
---

<section class="engines-console-section" id="motorlar">
  <div class="container">
    <!-- Başlık Bloğu -->
    <div class="console-header">
      <div class="console-badge">
        <span class="pulse-indicator"></span>
        <span>AKTİF ENDÜSTRİYEL KARAR MOTORLARI · DETERMINISTIC ENGINE V2.4</span>
      </div>
      <h2 class="console-title">Gerçek zamanlı çalışan 3 kurumsal finansal karar motoru.</h2>
      <p class="console-sub">
        Bu motorlar statik bir metin değil; AB Tüzüğü (EU 2023/956) formülleriyle çalışan, şirket verilerinizi anında finansal kâr erimesine, müşteri riskine ve bütçe deltasına çeviren aktif karar sistemleridir.
      </p>
    </div>

    <!-- Motor Sekmeleri (Tabs) -->
    <div class="engine-tabs-wrapper">
      <div class="engine-tabs-nav" role="tablist">
        <button type="button" class="tab-btn active" data-tab="engine-02" id="tab-02">
          <span class="tab-num">MOTOR 02 · 4.900 TL</span>
          <span class="tab-name">Ön Analiz Rapor Motoru</span>
          <span class="tab-status-chip chip-amber">OPERASYONEL HAZIR</span>
        </button>
        <button type="button" class="tab-btn" data-tab="engine-03" id="tab-03">
          <span class="tab-num">MOTOR 03 · 19.900 TL</span>
          <span class="tab-name">Müşteri Portföy &amp; Mahsup Motoru</span>
          <span class="tab-status-chip chip-blue">MİMARİ HAZIR</span>
        </button>
        <button type="button" class="tab-btn" data-tab="engine-04" id="tab-04">
          <span class="tab-num">MOTOR 04 · MONİTÖR</span>
          <span class="tab-name">Aylık Delta Risk Simülatörü</span>
          <span class="tab-status-chip chip-blue">SİMÜLASYON AKTİF</span>
        </button>
      </div>

      <!-- MOTOR 02 PANELİ: ÖN ANALİZ RAPOR MOTORU -->
      <div class="engine-tab-pane active" id="pane-engine-02">
        <div class="pane-grid-2">
          <!-- Sol: Girdiler -->
          <div class="pane-box form-side">
            <h3 class="box-title">Tesis &amp; GTIP Emisyon Parametreleri</h3>
            <p class="box-desc">Ürününüzün GTIP kodunu ve tesis emisyonlarını girin; motor anında net CBAM yükümlülüğü ve bilanço marj kaybı raporunu çıkarsın.</p>
            
            <div class="inputs-stack">
              <div class="field-item">
                <label for="m2-company">Firma Unvanı</label>
                <input type="text" id="m2-company" value="Örnek Metal Sanayi A.Ş." />
              </div>

              <div class="field-item">
                <label for="m2-gtip">GTIP Kodu ve Ürün Kategorisi</label>
                <select id="m2-gtip">
                  {OFFICIAL_GTIP_DATABASE.map(g => (
                    <option value={g.gtipCode} data-s1={g.defaultScope1} data-s2={g.defaultScope2} data-bench={g.benchmarkEur}>
                      {g.gtipCode} - {g.name}
                    </option>
                  ))}
                </select>
              </div>

              <div class="two-fields">
                <div class="field-item">
                  <label for="m2-volume">Yıllık AB Hacmi (ton)</label>
                  <input type="number" id="m2-volume" value="10000" min="100" step="500" />
                </div>
                <div class="field-item">
                  <label for="m2-sales-price">Satış Fiyatı (€/t)</label>
                  <input type="number" id="m2-sales-price" value="850" min="50" step="10" />
                </div>
              </div>

              <div class="two-fields">
                <div class="field-item">
                  <label for="m2-cost">Üretim Maliyeti (€/t)</label>
                  <input type="number" id="m2-cost" value="606" min="50" step="10" />
                </div>
                <div class="field-item">
                  <label for="m2-cbam-price">CBAM Baz Fiyat (€/tCO₂)</label>
                  <input type="number" id="m2-cbam-price" value="75.28" step="0.01" />
                </div>
              </div>

              <div class="two-fields">
                <div class="field-item">
                  <label for="m2-scope1">Scope 1 Doğrudan (tCO₂/t)</label>
                  <input type="number" id="m2-scope1" value="1.45" step="0.01" />
                </div>
                <div class="field-item">
                  <label for="m2-scope2">Scope 2 Dolaylı (tCO₂/t)</label>
                  <input type="number" id="m2-scope2" value="0.39" step="0.01" />
                </div>
              </div>
            </div>
          </div>

          <!-- Sağ: Rapor Çıktısı -->
          <div class="pane-box report-side">
            <div class="report-paper" id="printable-report">
              <div class="report-meta-header">
                <div>
                  <span class="rep-tag">CFO YÖNETİCİ ÖN ANALİZ RAPORU</span>
                  <h4 class="rep-title" id="rep-company-title">Örnek Metal Sanayi A.Ş.</h4>
                  <small class="rep-date" id="rep-date">2026 Resmî CBAM Değerlendirmesi</small>
                </div>
                <div class="rep-id-box mono" id="rep-id">KF-RPT-2026-A1</div>
              </div>

              <!-- Ana KPI Kartları -->
              <div class="rep-kpi-summary">
                <div class="rep-kpi-main">
                  <span class="rep-lbl">NET YILLIK KARBON MARUZİYETİ</span>
                  <strong class="rep-num-big" id="m2-out-exposure">€1.385.152</strong>
                  <span class="rep-sub" id="m2-out-per-ton">Ton başına ek maliyet: €138,52/t</span>
                </div>
              </div>

              <!-- Detaylı Tablo -->
              <table class="rep-mini-table">
                <tbody>
                  <tr>
                    <td>Spesifik Emisyon (Scope 1+2)</td>
                    <td class="mono right" id="m2-out-emission">1,84 tCO₂e / ton</td>
                  </tr>
                  <tr>
                    <td>Mevcut Brüt Kâr Marjı</td>
                    <td class="mono right" id="m2-out-cur-margin">%28,7</td>
                  </tr>
                  <tr>
                    <td>Karbon Sonrası Düzeltilmiş Marj</td>
                    <td class="mono right danger-text" id="m2-out-adj-margin">%12,4</td>
                  </tr>
                  <tr>
                    <td>Net Marj Erimesi</td>
                    <td class="mono right danger-text" id="m2-out-margin-loss">−16,3 Puan (%56,8 Kâr Kaybı)</td>
                  </tr>
                  <tr class="rep-action-tr">
                    <td><strong>Koruyucu Asgari Satış Fiyatı</strong></td>
                    <td class="mono right highlight-num" id="m2-out-req-price">€989,00 / ton (+%16,3)</td>
                  </tr>
                  <tr>
                    <td>Zarara Geçiren Karbon Eşiği</td>
                    <td class="mono right" id="m2-out-breakeven">€132,61 / tCO₂</td>
                  </tr>
                </tbody>
              </table>

              <!-- Aksiyon Butonları -->
              <div class="rep-actions-bar">
                <button type="button" class="btn btn-primary btn-print" onclick="window.print()">
                  <span>🖨️ Yönetici Raporunu Yazdır / PDF İndir</span>
                </button>
                <a href="#basvuru" class="btn btn-secondary">
                  <span>Bu Raporu Şirketiniz İçin Onaylatın (4.900 TL)</span>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- MOTOR 03 PANELİ: MÜŞTERİ PORTFÖY & MAHSUP KARAR MOTORU -->
      <div class="engine-tab-pane" id="pane-engine-03">
        <div class="portfolio-console">
          <!-- Üst Senaryo Barı: TR-ETS Mahsup Kaydırıcısı -->
          <div class="scenario-slider-box">
            <div class="slider-info">
              <span class="s-eyebrow">TR-ETS MADDE 9 İKİLİ MAHSUP SİMÜLATÖRÜ</span>
              <h3 class="slider-title">Türkiye'de Ödenen Karbon Bedelinin AB CBAM'ından Mahsup Oranı: <span id="m3-offset-val">%0</span></h3>
              <p class="slider-desc">Türkiye ETS yürürlüğe girdiğinde yerel ödenen karbon vergisi AB gümrüğünde mahsup edilecek. Mahsup oranının müşteri sözleşmelerinize etkisini canlı görün:</p>
            </div>
            <div class="slider-control">
              <input type="range" id="m3-offset-slider" min="0" max="100" step="25" value="0" />
              <div class="slider-ticks mono">
                <span>%0 (Mahsup Yok)</span>
                <span>%25</span>
                <span>%50 (Kısmi Mahsup)</span>
                <span>%75</span>
                <span>%100 (Tam Mahsup)</span>
              </div>
            </div>
          </div>

          <!-- Müşteri Sözleşmeleri Karar Tablosu -->
          <div class="contracts-table-card">
            <div class="table-responsive">
              <table class="contracts-table">
                <thead>
                  <tr>
                    <th>MÜŞTERİ / SÖZLEŞME</th>
                    <th>ÜLKE / TONAJ</th>
                    <th>SÖZLEŞME FİYATI</th>
                    <th>NET KARBON MALİYETİ</th>
                    <th>ESKİ MARJ</th>
                    <th>YENİ MARJ</th>
                    <th>RİSK DURUMU</th>
                    <th>CFO AKSİYON KARARI</th>
                  </tr>
                </thead>
                <tbody id="m3-contracts-tbody">
                  <!-- JS dinamik render edecek -->
                </tbody>
              </table>
            </div>

            <!-- Portföy Karar Özeti -->
            <div class="portfolio-summary-bar">
              <div class="p-stat">
                <span class="p-lbl">TOPLAM PORTFÖY CİROSU</span>
                <strong class="p-val" id="m3-total-rev">€8.300.000</strong>
              </div>
              <div class="p-stat">
                <span class="p-lbl">TOPLAM NET CBAM YÜKÜ</span>
                <strong class="p-val danger" id="m3-total-carbon">€1.385.152</strong>
              </div>
              <div class="p-stat">
                <span class="p-lbl">PORTFÖY ORTALAMA MARJ ERİMESİ</span>
                <strong class="p-val danger" id="m3-total-margin-loss">−16,7 Puan</strong>
              </div>
              <div class="p-takeaway-box">
                <strong id="m3-takeaway-text">Yönetim Kurulu Aksiyonu:</strong> 3 müşteriden 1'i kritik zarar bölgesindedir.
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- MOTOR 04 PANELİ: AYLIK MONİTÖR & DELTA RİSK MOTORU -->
      <div class="engine-tab-pane" id="pane-engine-04">
        <div class="monitor-console">
          <div class="monitor-grid">
            <!-- Sol: Piyasa Simülasyonu -->
            <div class="pane-box monitor-controls">
              <span class="eyebrow">DİNAMİK KOTASYON SİMÜLATÖRÜ</span>
              <h3 class="box-title">AB CBAM Haftalık Borsa Fiyatı Hareketi</h3>
              <p class="box-desc">
                Resmî baz gösterge €75,28/t'dur. AB borsa kotasyonları arttığında veya haftalık ihalelerde fiyat yükseldiğinde yıllık bütçenizdeki ve haftalık nakit akışınızdaki sapmayı canlı test edin.
              </p>

              <div class="interactive-slider-group">
                <div class="slider-head">
                  <label for="m4-price-slider">Yeni Borsa / Kotasyon Fiyatı:</label>
                  <strong class="slider-live-num" id="m4-price-display">€95,00 / tCO₂</strong>
                </div>
                <input type="range" id="m4-price-slider" min="65" max="140" step="1" value="95" />
                <div class="slider-limits mono">
                  <span>€65/t (İndirim)</span>
                  <span>€75,28 (Resmî Baz)</span>
                  <span>€100/t</span>
                  <span>€140/t (Kriz Eşiği)</span>
                </div>
              </div>

              <div class="monitor-inputs-inline">
                <div class="field-item">
                  <label for="m4-vol">Yıllık Sevkiyat (ton)</label>
                  <input type="number" id="m4-vol" value="10000" step="1000" />
                </div>
                <div class="field-item">
                  <label for="m4-factor">Emisyon Katsayısı (tCO₂/t)</label>
                  <input type="number" id="m4-factor" value="1.84" step="0.05" />
                </div>
                <div class="field-item">
                  <label for="m4-revenue">Yıllık Ciro (€)</label>
                  <input type="number" id="m4-revenue" value="8500000" step="100000" />
                </div>
              </div>
            </div>

            <!-- Sağ: Delta Alarm & Nakit Akışı Sapması -->
            <div class="pane-box monitor-results">
              <div class="delta-hero-card" id="m4-alarm-card">
                <div class="delta-header">
                  <span class="delta-badge" id="m4-badge">DİKKAT: RİSK EŞİĞİ AŞILDI</span>
                  <span class="delta-pct mono" id="m4-pct-change">+%26,2 Fiyat Artışı</span>
                </div>
                <div class="delta-main-stat">
                  <span class="d-label">YILLIK EK BÜTÇE SAPMASI (DELTA RİSK)</span>
                  <strong class="d-value" id="m4-annual-delta">+€362.848</strong>
                </div>
                <p class="delta-notice" id="m4-notice-text">
                  Fiyatın €75,28'den €95,00'e çıkması, operasyonel kârınızdan yıllık €362.848 daha buharlaştıracaktır.
                </p>
              </div>

              <div class="delta-sub-grid">
                <div class="delta-sub-box">
                  <span class="sub-lbl">Haftalık Nakit Akışı Erimesi</span>
                  <strong class="sub-val" id="m4-weekly-delta">+€6.978 / hafta</strong>
                  <small>52 haftalık sevkiyat takvimine göre</small>
                </div>
                <div class="delta-sub-box">
                  <span class="sub-lbl">Aylık Nakit Rezerv İhtiyacı</span>
                  <strong class="sub-val" id="m4-monthly-delta">+€30.237 / ay</strong>
                  <small>Gümrük teminat mektubu riski</small>
                </div>
                <div class="delta-sub-box">
                  <span class="sub-lbl">Ek Marj Kaybı</span>
                  <strong class="sub-val danger-text" id="m4-margin-delta">−4,3 Puan</strong>
                  <small>Toplam marjdan ek erime</small>
                </div>
                <div class="delta-sub-box highlight-box">
                  <span class="sub-lbl">Açık Tekliflere Eklenecek Zam</span>
                  <strong class="sub-val gold-text" id="m4-surcharge">+€36,28 / ton</strong>
                  <small>Dinamik teklif koruma payı</small>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function() {
    // 1. SEKME GEÇİŞİ (TABS)
    const tabBtns = document.querySelectorAll(".tab-btn");
    const tabPanes = document.querySelectorAll(".engine-tab-pane");

    tabBtns.forEach(btn => {
      btn.addEventListener("click", () => {
        tabBtns.forEach(b => b.classList.remove("active"));
        tabPanes.forEach(p => p.classList.remove("active"));
        btn.classList.add("active");
        const targetId = "pane-" + btn.getAttribute("data-tab");
        const targetPane = document.getElementById(targetId);
        if (targetPane) targetPane.classList.add("active");
      });
    });

    const fmtEur = new Intl.NumberFormat("tr-TR", { style: "currency", currency: "EUR", maximumFractionDigits: 0 });
    const fmtEurDec = new Intl.NumberFormat("tr-TR", { style: "currency", currency: "EUR", minimumFractionDigits: 2, maximumFractionDigits: 2 });
    const fmtPct = new Intl.NumberFormat("tr-TR", { minimumFractionDigits: 1, maximumFractionDigits: 1 });

    // 2. MOTOR 02: ÖN ANALİZ RAPOR MOTORU HESAPLAMASI
    const m2Company = document.getElementById("m2-company");
    const m2Gtip = document.getElementById("m2-gtip");
    const m2Vol = document.getElementById("m2-volume");
    const m2Sales = document.getElementById("m2-sales-price");
    const m2Cost = document.getElementById("m2-cost");
    const m2CbamPrice = document.getElementById("m2-cbam-price");
    const m2S1 = document.getElementById("m2-scope1");
    const m2S2 = document.getElementById("m2-scope2");

    const repCompany = document.getElementById("rep-company-title");
    const outExp = document.getElementById("m2-out-exposure");
    const outPerTon = document.getElementById("m2-out-per-ton");
    const outEmission = document.getElementById("m2-out-emission");
    const outCurMargin = document.getElementById("m2-out-cur-margin");
    const outAdjMargin = document.getElementById("m2-out-adj-margin");
    const outMarginLoss = document.getElementById("m2-out-margin-loss");
    const outReqPrice = document.getElementById("m2-out-req-price");
    const outBreakeven = document.getElementById("m2-out-breakeven");

    function calcMotor2() {
      const comp = m2Company ? m2Company.value || "İhracatçı Firma" : "İhracatçı Firma";
      if (repCompany) repCompany.textContent = comp;

      const vol = Math.max(1, parseFloat(m2Vol?.value) || 10000);
      const sales = Math.max(1, parseFloat(m2Sales?.value) || 850);
      const cost = Math.max(0, parseFloat(m2Cost?.value) || 606);
      const cbamP = Math.max(0, parseFloat(m2CbamPrice?.value) || 75.28);
      const s1 = Math.max(0, parseFloat(m2S1?.value) || 1.45);
      const s2 = Math.max(0, parseFloat(m2S2?.value) || 0.39);

      const totalEmission = s1 + s2;
      const perTonCarbon = totalEmission * cbamP;
      const totalExposure = vol * perTonCarbon;

      const rev = vol * sales;
      const curProfit = rev - (vol * cost);
      const curMargin = (curProfit / rev) * 100;

      const newCost = cost + perTonCarbon;
      const adjProfit = rev - (vol * newCost);
      const adjMargin = (adjProfit / rev) * 100;
      const marginLoss = curMargin - adjMargin;
      const profitErosion = curProfit > 0 ? ((curProfit - adjProfit) / curProfit) * 100 : 100;

      const reqPrice = sales + perTonCarbon;
      const reqRevPct = (perTonCarbon / sales) * 100;
      const breakeven = totalEmission > 0 ? (sales - cost) / totalEmission : 0;

      if (outExp) outExp.textContent = fmtEur.format(totalExposure);
      if (outPerTon) outPerTon.textContent = "Ton başına ek maliyet: " + fmtEurDec.format(perTonCarbon) + "/t";
      if (outEmission) outEmission.textContent = fmtPct.format(totalEmission) + " tCO₂e / ton";
      if (outCurMargin) outCurMargin.textContent = "%" + fmtPct.format(curMargin);
      if (outAdjMargin) outAdjMargin.textContent = "%" + fmtPct.format(adjMargin);
      if (outMarginLoss) outMarginLoss.textContent = "−" + fmtPct.format(marginLoss) + " Puan (%" + fmtPct.format(profitErosion) + " Kâr Kaybı)";
      if (outReqPrice) outReqPrice.textContent = fmtEurDec.format(reqPrice) + "/t (+%" + fmtPct.format(reqRevPct) + ")";
      if (outBreakeven) outBreakeven.textContent = fmtEurDec.format(breakeven) + " / tCO₂";
    }

    if (m2Gtip) {
      m2Gtip.addEventListener("change", () => {
        const opt = m2Gtip.options[m2Gtip.selectedIndex];
        if (opt) {
          if (m2S1) m2S1.value = opt.getAttribute("data-s1");
          if (m2S2) m2S2.value = opt.getAttribute("data-s2");
          calcMotor2();
        }
      });
    }

    [m2Company, m2Vol, m2Sales, m2Cost, m2CbamPrice, m2S1, m2S2].forEach(el => {
      if (el) {
        el.addEventListener("input", calcMotor2);
        el.addEventListener("change", calcMotor2);
      }
    });

    // 3. MOTOR 03: MÜŞTERİ PORTFÖY & MAHSUP KARAR MOTORU HESAPLAMASI
    const sampleContracts = [
      { id: "c1", client: "ABC Stahl GmbH", country: "Almanya", vol: 5000, price: 860, cost: 620, factor: 1.84 },
      { id: "c2", client: "DEF Metalli SpA", country: "İtalya", vol: 3500, price: 830, cost: 610, factor: 1.84 },
      { id: "c3", client: "XYZ Construct BV", country: "Hollanda", vol: 1500, price: 790, cost: 640, factor: 1.84 }
    ];

    const offsetSlider = document.getElementById("m3-offset-slider");
    const offsetValDisplay = document.getElementById("m3-offset-val");
    const contractsTbody = document.getElementById("m3-contracts-tbody");
    const m3TotalRev = document.getElementById("m3-total-rev");
    const m3TotalCarbon = document.getElementById("m3-total-carbon");
    const m3TotalMarginLoss = document.getElementById("m3-total-margin-loss");
    const m3Takeaway = document.getElementById("m3-takeaway-text");

    function calcMotor3() {
      const offsetPct = parseFloat(offsetSlider ? offsetSlider.value : "0") || 0;
      if (offsetValDisplay) offsetValDisplay.textContent = "%" + offsetPct;
      const validOffset = offsetPct / 100;
      const cbamPrice = 75.28;

      let totalVol = 0;
      let totalRev = 0;
      let totalBaseProfit = 0;
      let totalNetCarbon = 0;
      let criticalCount = 0;

      let html = "";
      sampleContracts.forEach(c => {
        const rev = c.vol * c.price;
        const baseProfit = rev - (c.vol * c.cost);
        const grossCarbon = c.vol * c.factor * cbamPrice;
        const netCarbon = grossCarbon * (1 - validOffset);

        const marginBefore = (baseProfit / rev) * 100;
        const profitAfter = baseProfit - netCarbon;
        const marginAfter = (profitAfter / rev) * 100;
        const reqRevPct = (netCarbon / rev) * 100;

        let badgeClass = "badge-safe";
        let statusText = "KORUNABİLİR";
        let actionText = "Mevcut marj güvenli";

        if (marginAfter < 5) {
          badgeClass = "badge-danger";
          statusText = "ZARAR / RİSKLİ";
          actionText = `Acil revizyon (+%${reqRevPct.toFixed(1)} zam)`;
          criticalCount++;
        } else if (marginAfter < 14) {
          badgeClass = "badge-warn";
          statusText = "REVİZYON ŞART";
          actionText = `Yenilemede +€${(netCarbon / c.vol).toFixed(0)}/t fiyat geçişi`;
        }

        totalVol += c.vol;
        totalRev += rev;
        totalBaseProfit += baseProfit;
        totalNetCarbon += netCarbon;

        html += `
          <tr>
            <td><strong>${c.client}</strong></td>
            <td>${c.country} · ${c.vol.toLocaleString("tr-TR")} t</td>
            <td class="mono">€${c.price}/t</td>
            <td class="mono danger-text">€${Math.round(netCarbon).toLocaleString("tr-TR")}</td>
            <td class="mono">%${marginBefore.toFixed(1)}</td>
            <td class="mono ${marginAfter < 5 ? 'danger-bold' : ''}">%${marginAfter.toFixed(1)}</td>
            <td><span class="contract-badge ${badgeClass}">${statusText}</span></td>
            <td class="action-rec">${actionText}</td>
          </tr>
        `;
      });

      if (contractsTbody) contractsTbody.innerHTML = html;

      const pMarginBefore = totalRev > 0 ? (totalBaseProfit / totalRev) * 100 : 0;
      const pMarginAfter = totalRev > 0 ? ((totalBaseProfit - totalNetCarbon) / totalRev) * 100 : 0;
      const pLossPoints = pMarginBefore - pMarginAfter;

      if (m3TotalRev) m3TotalRev.textContent = fmtEur.format(totalRev);
      if (m3TotalCarbon) m3TotalCarbon.textContent = fmtEur.format(totalNetCarbon);
      if (m3TotalMarginLoss) m3TotalMarginLoss.textContent = "−" + fmtPct.format(pLossPoints) + " Puan";

      if (m3Takeaway) {
        if (criticalCount > 0) {
          m3Takeaway.innerHTML = `⚠️ <strong>Yönetim Kurulu Aksiyonu:</strong> 3 sözleşmeden ${criticalCount} tanesi kritik zarar bölgesindedir. %${offsetPct} mahsup senaryosunda dahi bu müşteriler kârınızı eritmektedir.`;
        } else {
          m3Takeaway.innerHTML = `✓ <strong>Yönetim Kurulu Aksiyonu:</strong> Tüm sözleşmeler pozitif marjda kalmaktadır. Mahsup oranı (%${offsetPct}) net yükümlülüğünüzü €${Math.round(totalNetCarbon).toLocaleString("tr-TR")}'ye düşürmüştür.`;
        }
      }
    }

    if (offsetSlider) offsetSlider.addEventListener("input", calcMotor3);

    // 4. MOTOR 04: AYLIK MONİTÖR & DELTA RİSK MOTORU HESAPLAMASI
    const m4Slider = document.getElementById("m4-price-slider");
    const m4PriceDisp = document.getElementById("m4-price-display");
    const m4Vol = document.getElementById("m4-vol");
    const m4Factor = document.getElementById("m4-factor");
    const m4Revenue = document.getElementById("m4-revenue");

    const m4AlarmCard = document.getElementById("m4-alarm-card");
    const m4Badge = document.getElementById("m4-badge");
    const m4PctChange = document.getElementById("m4-pct-change");
    const m4AnnualDelta = document.getElementById("m4-annual-delta");
    const m4Notice = document.getElementById("m4-notice-text");

    const m4Weekly = document.getElementById("m4-weekly-delta");
    const m4Monthly = document.getElementById("m4-monthly-delta");
    const m4MarginDelta = document.getElementById("m4-margin-delta");
    const m4Surcharge = document.getElementById("m4-surcharge");

    function calcMotor4() {
      const basePrice = 75.28;
      const simPrice = parseFloat(m4Slider ? m4Slider.value : "95") || 95;
      if (m4PriceDisp) m4PriceDisp.textContent = "€" + simPrice.toFixed(2) + " / tCO₂";

      const vol = Math.max(1, parseFloat(m4Vol?.value) || 10000);
      const factor = Math.max(0.1, parseFloat(m4Factor?.value) || 1.84);
      const rev = Math.max(1, parseFloat(m4Revenue?.value) || 8500000);

      const deltaPrice = simPrice - basePrice;
      const deltaPricePct = (deltaPrice / basePrice) * 100;

      const annualBaseCost = vol * factor * basePrice;
      const annualSimCost = vol * factor * simPrice;
      const annualDelta = annualSimCost - annualBaseCost;

      const weeklyDelta = annualDelta / 52;
      const monthlyDelta = annualDelta / 12;
      const marginErosion = (annualDelta / rev) * 100;
      const surcharge = factor * deltaPrice;

      const sign = deltaPrice >= 0 ? "+" : "−";
      const signPct = deltaPricePct >= 0 ? "+" : "";

      if (m4AnnualDelta) m4AnnualDelta.textContent = (annualDelta >= 0 ? "+" : "−") + fmtEur.format(Math.abs(annualDelta));
      if (m4PctChange) m4PctChange.textContent = signPct + fmtPct.format(deltaPricePct) + "% Borsa Hareketi";
      if (m4Weekly) m4Weekly.textContent = (weeklyDelta >= 0 ? "+" : "−") + fmtEur.format(Math.abs(weeklyDelta)) + " / hafta";
      if (m4Monthly) m4Monthly.textContent = (monthlyDelta >= 0 ? "+" : "−") + fmtEur.format(Math.abs(monthlyDelta)) + " / ay";
      if (m4MarginDelta) m4MarginDelta.textContent = (marginErosion >= 0 ? "−" : "+") + fmtPct.format(Math.abs(marginErosion)) + " Puan";
      if (m4Surcharge) m4Surcharge.textContent = (surcharge >= 0 ? "+" : "−") + fmtEurDec.format(Math.abs(surcharge)) + "/t";

      if (m4AlarmCard && m4Badge && m4Notice) {
        if (annualDelta > 150000 || deltaPricePct > 20) {
          m4AlarmCard.className = "delta-hero-card critical-alert";
          m4Badge.textContent = "KRİTİK RİSK ALARMI: BÜTÇE EŞİĞİ AŞILDI";
          m4Notice.textContent = `Fiyatın €${basePrice} seviyesinden €${simPrice.toFixed(2)}'ye yükselmesi, şirketin operasyonel brüt kârını yıllık ${fmtEur.format(annualDelta)} eritmektedir. Açık tekliflerinize derhal +${fmtEurDec.format(surcharge)}/t dinamik karbon zammı uygulayın!`;
        } else if (annualDelta > 40000) {
          m4AlarmCard.className = "delta-hero-card elevated-alert";
          m4Badge.textContent = "DİKKAT: RİSK EŞİĞİ AŞILDI";
          m4Notice.textContent = `Fiyat artışı maruziyet bütçenizi ${fmtEur.format(annualDelta)} artırdı. Haftalık nakit rezervinizi ${fmtEur.format(weeklyDelta)} yükseltmeniz önerilir.`;
        } else {
          m4AlarmCard.className = "delta-hero-card normal-alert";
          m4Badge.textContent = "BÜTÇE TOLERANSI İÇİNDE";
          m4Notice.textContent = `Kotasyon hareketi bütçe sapma limitleriniz dahilindedir. Ek aksiyon gerekmemektedir.`;
        }
      }
    }

    if (m4Slider) m4Slider.addEventListener("input", calcMotor4);
    [m4Vol, m4Factor, m4Revenue].forEach(el => {
      if (el) el.addEventListener("input", calcMotor4);
    });

    // İlk Çalıştırma
    calcMotor2();
    calcMotor3();
    calcMotor4();
  })();
</script>

