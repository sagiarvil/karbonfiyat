---
import { REFERENCE_GTIP_PROFILES } from "../lib/cbam-report-engine";
import { DEFAULT_SAMPLE_PORTFOLIO } from "../lib/portfolio-decision-engine";
---

<section class="engines-console-section" id="motorlar">
  <div class="container">
    <!-- Başlık Bloğu -->
    <div class="console-header">
      <div class="console-badge">
        <span class="pulse-indicator"></span>
        <span>AKTİF ENDÜSTRİYEL KARAR MOTORLARI · DETERMINISTIC ENGINE V2.4</span>
      </div>
      <h2 class="console-title">Çalışan 3 finansal karar motoru.</h2>
      <p class="console-sub">
        Bu motorlar şirket verilerini deterministik finansal formüllerle karbon maliyetine, müşteri riskine ve bütçe deltasına çevirir. Demo referans katsayıları resmî emisyon faktörü değildir; gerçek analizde doğrulanmış tesis/ürün verisi kullanılmalıdır.
      </p>
    </div>

    <!-- Motor Sekmeleri (Tabs) -->
    <div class="engine-tabs-wrapper">
      <div class="engine-tabs-nav" role="tablist">
        <button type="button" class="tab-btn active" data-tab="engine-02" id="tab-02">
          <span class="tab-num">MOTOR 02 · 4.900 TL</span>
          <span class="tab-name">Ön Analiz Rapor Motoru</span>
          <span class="tab-status-chip chip-amber">ÇALIŞAN MOTOR</span>
        </button>
        <button type="button" class="tab-btn" data-tab="engine-03" id="tab-03">
          <span class="tab-num">MOTOR 03 · 19.900 TL</span>
          <span class="tab-name">Müşteri Portföy &amp; Mahsup Motoru</span>
          <span class="tab-status-chip chip-blue">ÇALIŞAN SİMÜLASYON</span>
        </button>
        <button type="button" class="tab-btn" data-tab="engine-04" id="tab-04">
          <span class="tab-num">MOTOR 04 · MONİTÖR</span>
          <span class="tab-name">Aylık Delta Risk Simülatörü</span>
          <span class="tab-status-chip chip-blue">ÇALIŞAN SİMÜLASYON</span>
        </button>
      </div>

      <!-- MOTOR 02 PANELİ: ÖN ANALİZ RAPOR MOTORU -->
      <div class="engine-tab-pane active" id="pane-engine-02">
        <div class="pane-grid-2">
          <!-- Sol: Girdiler -->
          <div class="pane-box form-side">
            <h3 class="box-title">Tesis &amp; GTIP Emisyon Parametreleri</h3>
            <p class="box-desc">Ürününüzün GTİP kodunu ve tesis emisyonlarını girin; motor finansal CBAM maruziyeti ve marj etkisini hesaplasın. Listelenen başlangıç emisyonları yalnızca demo referansıdır.</p>
            
            <div class="inputs-stack">
              <div class="field-item">
                <label for="m2-company">Firma Unvanı</label>
                <input type="text" id="m2-company" value="Örnek Metal Sanayi A.Ş." />
              </div>

              <div class="field-item">
                <label for="m2-gtip">GTIP Kodu ve Ürün Kategorisi</label>
                <select id="m2-gtip">
                  {REFERENCE_GTIP_PROFILES.map(g => (
                    <option value={g.gtipCode} data-s1={g.defaultScope1} data-s2={g.defaultScope2} data-bench={g.benchmarkEur}>
                      {g.gtipCode} - {g.name}
                    </option>
                  ))}
                </select>
              </div>

              <div class="two-fields">
                <div class="field-item">
                  <label for="m2-volume">Yıllık AB Hacmi (ton)</label>
                  <input type="number" id="m2-volume" value="10000" min="100" step="500" />
                </div>
                <div class="field-item">
                  <label for="m2-sales-price">Satış Fiyatı (€/t)</label>
                  <input type="number" id="m2-sales-price" value="850" min="50" step="10" />
                </div>
              </div>

              <div class="two-fields">
                <div class="field-item">
                  <label for="m2-cost">Üretim Maliyeti (€/t)</label>
                  <input type="number" id="m2-cost" value="606" min="50" step="10" />
                </div>
                <div class="field-item">
                  <label for="m2-cbam-price">CBAM Baz Fiyat (€/tCO₂)</label>
                  <input type="number" id="m2-cbam-price" value="75.28" step="0.01" />
                </div>
              </div>

              <div class="two-fields">
                <div class="field-item">
                  <label for="m2-scope1">Scope 1 Doğrudan (tCO₂/t)</label>
                  <input type="number" id="m2-scope1" value="1.45" step="0.01" />
                </div>
                <div class="field-item">
                  <label for="m2-scope2">Scope 2 Dolaylı (tCO₂/t)</label>
                  <input type="number" id="m2-scope2" value="0.39" step="0.01" />
                </div>
              </div>
            </div>
          </div>

          <!-- Sağ: Rapor Çıktısı -->
          <div class="pane-box report-side">
            <div class="report-paper" id="printable-report">
              <div class="report-meta-header">
                <div>
                  <span class="rep-tag">CFO YÖNETİCİ ÖN ANALİZ RAPORU</span>
                  <h4 class="rep-title" id="rep-company-title">Örnek Metal Sanayi A.Ş.</h4>
                  <small class="rep-date" id="rep-date">2026 Resmî CBAM Değerlendirmesi</small>
                </div>
                <div class="rep-id-box mono" id="rep-id">KF-RPT-2026-A1</div>
              </div>

              <!-- Ana KPI Kartları -->
              <div class="rep-kpi-summary">
                <div class="rep-kpi-main">
                  <span class="rep-lbl">NET YILLIK KARBON MARUZİYETİ</span>
                  <strong class="rep-num-big" id="m2-out-exposure">€1.385.152</strong>
                  <span class="rep-sub" id="m2-out-per-ton">Ton başına ek maliyet: €138,52/t</span>
                </div>
              </div>

              <!-- Detaylı Tablo -->
              <table class="rep-mini-table">
                <tbody>
                  <tr>
                    <td>Spesifik Emisyon (Scope 1+2)</td>
                    <td class="mono right" id="m2-out-emission">1,84 tCO₂e / ton</td>
                  </tr>
                  <tr>
                    <td>Mevcut Brüt Kâr Marjı</td>
                    <td class="mono right" id="m2-out-cur-margin">%28,7</td>
                  </tr>
                  <tr>
                    <td>Karbon Sonrası Düzeltilmiş Marj</td>
                    <td class="mono right danger-text" id="m2-out-adj-margin">%12,4</td>
                  </tr>
                  <tr>
                    <td>Net Marj Erimesi</td>
                    <td class="mono right danger-text" id="m2-out-margin-loss">−16,3 Puan (%56,8 Kâr Kaybı)</td>
                  </tr>
                  <tr class="rep-action-tr">
                    <td><strong>Koruyucu Asgari Satış Fiyatı</strong></td>
                    <td class="mono right highlight-num" id="m2-out-req-price">€989,00 / ton (+%16,3)</td>
                  </tr>
                  <tr>
                    <td>Zarara Geçiren Karbon Eşiği</td>
                    <td class="mono right" id="m2-out-breakeven">€132,61 / tCO₂</td>
                  </tr>
                </tbody>
              </table>

              <!-- Aksiyon Butonları -->
              <div class="rep-actions-bar">
                <button type="button" class="btn btn-primary btn-print" onclick="window.print()">
                  <span>🖨️ Yönetici Raporunu Yazdır / PDF İndir</span>
                </button>
                <a href="#basvuru" class="btn btn-secondary">
                  <span>Bu Raporu Şirketiniz İçin Onaylatın (4.900 TL)</span>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- MOTOR 03 PANELİ: MÜŞTERİ PORTFÖY & MAHSUP KARAR MOTORU -->
      <div class="engine-tab-pane" id="pane-engine-03">
        <div class="portfolio-console">
          <!-- Üst Senaryo Barı: TR-ETS Mahsup Kaydırıcısı -->
          <div class="scenario-slider-box">
            <div class="slider-info">
              <span class="s-eyebrow">TR-ETS MADDE 9 İKİLİ MAHSUP SİMÜLATÖRÜ</span>
              <h3 class="slider-title">Türkiye'de Ödenen Karbon Bedelinin AB CBAM'ından Mahsup Oranı: <span id="m3-offset-val">%0</span></h3>
              <p class="slider-desc">Türkiye ETS yürürlüğe girdiğinde yerel ödenen karbon vergisi AB gümrüğünde mahsup edilecek. Mahsup oranının müşteri sözleşmelerinize etkisini canlı görün:</p>
            </div>
            <div class="slider-control">
              <input type="range" id="m3-offset-slider" min="0" max="100" step="25" value="0" aria-label="Türkiye ETS mahsup oranı (%)" />
              <div class="slider-ticks mono">
                <span>%0 (Mahsup Yok)</span>
                <span>%25</span>
                <span>%50 (Kısmi Mahsup)</span>
                <span>%75</span>
                <span>%100 (Tam Mahsup)</span>
              </div>
            </div>
          </div>

          <!-- Müşteri Sözleşmeleri Karar Tablosu -->
          <div class="contracts-table-card">
            <div class="table-responsive">
              <table class="contracts-table">
                <thead>
                  <tr>
                    <th>MÜŞTERİ / SÖZLEŞME</th>
                    <th>ÜLKE / TONAJ</th>
                    <th>SÖZLEŞME FİYATI</th>
                    <th>NET KARBON MALİYETİ</th>
                    <th>ESKİ MARJ</th>
                    <th>YENİ MARJ</th>
                    <th>RİSK DURUMU</th>
                    <th>CFO AKSİYON KARARI</th>
                  </tr>
                </thead>
                <tbody id="m3-contracts-tbody">
                  <!-- JS dinamik render edecek -->
                </tbody>
              </table>
            </div>

            <!-- Portföy Karar Özeti -->
            <div class="portfolio-summary-bar">
              <div class="p-stat">
                <span class="p-lbl">TOPLAM PORTFÖY CİROSU</span>
                <strong class="p-val" id="m3-total-rev">€8.300.000</strong>
              </div>
              <div class="p-stat">
                <span class="p-lbl">TOPLAM NET CBAM YÜKÜ</span>
                <strong class="p-val danger" id="m3-total-carbon">€1.385.152</strong>
              </div>
              <div class="p-stat">
                <span class="p-lbl">PORTFÖY ORTALAMA MARJ ERİMESİ</span>
                <strong class="p-val danger" id="m3-total-margin-loss">−16,7 Puan</strong>
              </div>
              <div class="p-takeaway-box">
                <strong id="m3-takeaway-text">Yönetim Kurulu Aksiyonu:</strong> 3 müşteriden 1'i kritik zarar bölgesindedir.
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- MOTOR 04 PANELİ: AYLIK MONİTÖR & DELTA RİSK MOTORU -->
      <div class="engine-tab-pane" id="pane-engine-04">
        <div class="monitor-console">
          <div class="monitor-grid">
            <!-- Sol: Piyasa Simülasyonu -->
            <div class="pane-box monitor-controls">
              <span class="eyebrow">DİNAMİK KOTASYON SİMÜLATÖRÜ</span>
              <h3 class="box-title">Karbon Fiyatı Senaryo Hareketi</h3>
              <p class="box-desc">
                Baz karbon fiyatı €75,28/tCO₂ olarak alınır. Farklı fiyat senaryolarının yıllık bütçe, aylık/haftalık nakit akışı ve teklif fiyatına etkisini test edin.
              </p>

              <div class="interactive-slider-group">
                <div class="slider-head">
                  <label for="m4-price-slider">Yeni Borsa / Kotasyon Fiyatı:</label>
                  <strong class="slider-live-num" id="m4-price-display">€95,00 / tCO₂</strong>
                </div>
                <input type="range" id="m4-price-slider" min="65" max="140" step="1" value="95" />
                <div class="slider-limits mono">
                  <span>€65/t (İndirim)</span>
                  <span>€75,28 (Resmî Baz)</span>
                  <span>€100/t</span>
                  <span>€140/t (Kriz Eşiği)</span>
                </div>
              </div>

              <div class="monitor-inputs-inline">
                <div class="field-item">
                  <label for="m4-vol">Yıllık Sevkiyat (ton)</label>
                  <input type="number" id="m4-vol" value="10000" step="1000" />
                </div>
                <div class="field-item">
                  <label for="m4-factor">Emisyon Katsayısı (tCO₂/t)</label>
                  <input type="number" id="m4-factor" value="1.84" step="0.05" />
                </div>
                <div class="field-item">
                  <label for="m4-revenue">Yıllık Ciro (€)</label>
                  <input type="number" id="m4-revenue" value="8500000" step="100000" />
                </div>
              </div>
            </div>

            <!-- Sağ: Delta Alarm & Nakit Akışı Sapması -->
            <div class="pane-box monitor-results">
              <div class="delta-hero-card" id="m4-alarm-card">
                <div class="delta-header">
                  <span class="delta-badge" id="m4-badge">DİKKAT: RİSK EŞİĞİ AŞILDI</span>
                  <span class="delta-pct mono" id="m4-pct-change">+%26,2 Fiyat Artışı</span>
                </div>
                <div class="delta-main-stat">
                  <span class="d-label">YILLIK EK BÜTÇE SAPMASI (DELTA RİSK)</span>
                  <strong class="d-value" id="m4-annual-delta">+€362.848</strong>
                </div>
                <p class="delta-notice" id="m4-notice-text">
                  Fiyatın €75,28'den €95,00'e çıkması, operasyonel kârınızdan yıllık €362.848 daha buharlaştıracaktır.
                </p>
              </div>

              <div class="delta-sub-grid">
                <div class="delta-sub-box">
                  <span class="sub-lbl">Haftalık Nakit Akışı Erimesi</span>
                  <strong class="sub-val" id="m4-weekly-delta">+€6.978 / hafta</strong>
                  <small>52 haftalık sevkiyat takvimine göre</small>
                </div>
                <div class="delta-sub-box">
                  <span class="sub-lbl">Aylık Nakit Rezerv İhtiyacı</span>
                  <strong class="sub-val" id="m4-monthly-delta">+€30.237 / ay</strong>
                  <small>Gümrük teminat mektubu riski</small>
                </div>
                <div class="delta-sub-box">
                  <span class="sub-lbl">Ek Marj Kaybı</span>
                  <strong class="sub-val danger-text" id="m4-margin-delta">−4,3 Puan</strong>
                  <small>Toplam marjdan ek erime</small>
                </div>
                <div class="delta-sub-box highlight-box">
                  <span class="sub-lbl">Açık Tekliflere Eklenecek Zam</span>
                  <strong class="sub-val gold-text" id="m4-surcharge">+€36,28 / ton</strong>
                  <small>Dinamik teklif koruma payı</small>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { computeCarbonPnlCore, computePortfolioCore, computeMonitorCore } from "../lib/financial-core.mjs";

  const root = document.querySelector("#motorlar");

  if (root) {
    const fmtEur = new Intl.NumberFormat("tr-TR", { style: "currency", currency: "EUR", maximumFractionDigits: 0 });
    const fmtEurDec = new Intl.NumberFormat("tr-TR", { style: "currency", currency: "EUR", minimumFractionDigits: 2, maximumFractionDigits: 2 });
    const fmtPct = new Intl.NumberFormat("tr-TR", { minimumFractionDigits: 1, maximumFractionDigits: 1 });

    root.querySelectorAll(".tab-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        root.querySelectorAll(".tab-btn").forEach((b) => b.classList.remove("active"));
        root.querySelectorAll(".engine-tab-pane").forEach((pane) => pane.classList.remove("active"));
        btn.classList.add("active");
        root.querySelector("#pane-" + btn.getAttribute("data-tab"))?.classList.add("active");
      });
    });

    const m2 = {
      company: root.querySelector("#m2-company"),
      gtip: root.querySelector("#m2-gtip"),
      volume: root.querySelector("#m2-volume"),
      sales: root.querySelector("#m2-sales-price"),
      cost: root.querySelector("#m2-cost"),
      price: root.querySelector("#m2-cbam-price"),
      s1: root.querySelector("#m2-scope1"),
      s2: root.querySelector("#m2-scope2"),
      companyOut: root.querySelector("#rep-company-title"),
      exposure: root.querySelector("#m2-out-exposure"),
      perTon: root.querySelector("#m2-out-per-ton"),
      emission: root.querySelector("#m2-out-emission"),
      curMargin: root.querySelector("#m2-out-cur-margin"),
      adjMargin: root.querySelector("#m2-out-adj-margin"),
      marginLoss: root.querySelector("#m2-out-margin-loss"),
      reqPrice: root.querySelector("#m2-out-req-price"),
      breakeven: root.querySelector("#m2-out-breakeven")
    };

    const calcMotor2 = () => {
      try {
        const intensity = Number.parseFloat(m2.s1?.value ?? "") + Number.parseFloat(m2.s2?.value ?? "");
        const result = computeCarbonPnlCore({
          volume: Number.parseFloat(m2.volume?.value ?? ""),
          intensity,
          salesPrice: Number.parseFloat(m2.sales?.value ?? ""),
          productionCost: Number.parseFloat(m2.cost?.value ?? ""),
          carbonPrice: Number.parseFloat(m2.price?.value ?? ""),
          targetMarginPct: 20
        });

        if (m2.companyOut) m2.companyOut.textContent = m2.company?.value?.trim() || "İhracatçı Firma";
        if (m2.exposure) m2.exposure.textContent = fmtEur.format(result.carbonCost);
        if (m2.perTon) m2.perTon.textContent = "Ton başına ek maliyet: " + fmtEurDec.format(result.carbonCostPerTon) + "/t";
        if (m2.emission) m2.emission.textContent = fmtPct.format(result.intensity) + " tCO₂e / ton";
        if (m2.curMargin) m2.curMargin.textContent = "%" + fmtPct.format(result.marginBefore);
        if (m2.adjMargin) m2.adjMargin.textContent = "%" + fmtPct.format(result.marginAfter);
        if (m2.marginLoss) m2.marginLoss.textContent = "−" + fmtPct.format(result.marginDelta) + " Puan";
        if (m2.reqPrice) m2.reqPrice.textContent = fmtEurDec.format(result.protectivePrice) + " / ton (+" + fmtPct.format(result.revisionPct) + "%)";
        if (m2.breakeven) m2.breakeven.textContent = fmtEurDec.format(result.breakEven) + " / tCO₂";
      } catch {
        [m2.exposure, m2.perTon, m2.emission, m2.curMargin, m2.adjMargin, m2.marginLoss, m2.reqPrice, m2.breakeven]
          .forEach((el) => { if (el) el.textContent = "Geçersiz veri"; });
      }
    };

    m2.gtip?.addEventListener("change", () => {
      const option = m2.gtip.selectedOptions?.[0];
      if (!option) return;
      if (m2.s1) m2.s1.value = option.dataset.s1 || "";
      if (m2.s2) m2.s2.value = option.dataset.s2 || "";
      if (m2.price && option.dataset.bench) m2.price.value = option.dataset.bench;
      calcMotor2();
    });

    [m2.company, m2.volume, m2.sales, m2.cost, m2.price, m2.s1, m2.s2]
      .forEach((el) => el?.addEventListener("input", calcMotor2));

    const samplePortfolio = [
      { client: "ABC Stahl GmbH", country: "Almanya", volume: 5000, sales: 860, cost: 620, emission: 1.84 },
      { client: "DEF Metalli SpA", country: "İtalya", volume: 3500, sales: 830, cost: 610, emission: 1.84 },
      { client: "XYZ Construct BV", country: "Hollanda", volume: 1500, sales: 790, cost: 640, emission: 1.84 }
    ];

    const offsetSlider = root.querySelector("#m3-offset-slider");
    const offsetVal = root.querySelector("#m3-offset-val");
    const contractsTbody = root.querySelector("#m3-contracts-tbody");
    const m3TotalRev = root.querySelector("#m3-total-rev");
    const m3TotalCarbon = root.querySelector("#m3-total-carbon");
    const m3TotalMarginLoss = root.querySelector("#m3-total-margin-loss");
    const m3Takeaway = root.querySelector("#m3-takeaway-text");

    const calcMotor3 = () => {
      try {
        const offsetPct = Number.parseFloat(offsetSlider?.value ?? "0");
        const result = computePortfolioCore(samplePortfolio, 75.28, offsetPct);
        if (offsetVal) offsetVal.textContent = "%" + fmtPct.format(result.offsetPct);

        if (contractsTbody) {
          contractsTbody.innerHTML = result.evaluations.map((item) => {
            const badge = item.risk === "CRITICAL"
              ? ["KRİTİK", "badge-danger"]
              : item.risk === "REVISION"
                ? ["REVİZYON", "badge-warn"]
                : ["KORUNABİLİR", "badge-safe"];

            const action = item.risk === "CRITICAL"
              ? "Fiyat revizyonu veya hacim kararı zorunlu."
              : item.risk === "REVISION"
                ? "Yenilemede karbon maliyetini fiyata geçir."
                : "Sözleşme marjı korunuyor; izlemeye devam et.";

            return '<tr>' +
              '<td><strong>' + item.client + '</strong></td>' +
              '<td>' + item.country + '<br><small>' + item.volume.toLocaleString("tr-TR") + ' ton</small></td>' +
              '<td>' + fmtEurDec.format(item.sales) + '/t</td>' +
              '<td class="danger-bold">' + fmtEur.format(item.netCarbon) + '</td>' +
              '<td>%' + fmtPct.format(item.marginBefore) + '</td>' +
              '<td>%' + fmtPct.format(item.marginAfter) + '</td>' +
              '<td><span class="contract-badge ' + badge[1] + '">' + badge[0] + '</span></td>' +
              '<td><span class="action-rec">' + action + '</span></td>' +
            '</tr>';
          }).join("");
        }

        if (m3TotalRev) m3TotalRev.textContent = fmtEur.format(result.totalRevenue);
        if (m3TotalCarbon) m3TotalCarbon.textContent = fmtEur.format(result.totalNetCarbon);
        if (m3TotalMarginLoss) m3TotalMarginLoss.textContent = "−" + fmtPct.format(result.marginLoss) + " Puan";
        if (m3Takeaway) {
          m3Takeaway.textContent = result.criticalCount > 0
            ? "Yönetim Kurulu Aksiyonu: " + result.evaluations.length + " sözleşmeden " + result.criticalCount + " tanesi kritik zarar bölgesindedir."
            : "Yönetim Kurulu Aksiyonu: Tüm sözleşmeler pozitif marjda kalmaktadır.";
        }
      } catch {
        if (contractsTbody) contractsTbody.innerHTML = '<tr><td colspan="8">Geçersiz portföy verisi.</td></tr>';
      }
    };

    offsetSlider?.addEventListener("input", calcMotor3);

    const m4 = {
      slider: root.querySelector("#m4-price-slider"),
      display: root.querySelector("#m4-price-display"),
      volume: root.querySelector("#m4-vol"),
      factor: root.querySelector("#m4-factor"),
      revenue: root.querySelector("#m4-revenue"),
      card: root.querySelector("#m4-alarm-card"),
      badge: root.querySelector("#m4-badge"),
      pct: root.querySelector("#m4-pct-change"),
      annual: root.querySelector("#m4-annual-delta"),
      notice: root.querySelector("#m4-notice-text"),
      weekly: root.querySelector("#m4-weekly-delta"),
      monthly: root.querySelector("#m4-monthly-delta"),
      margin: root.querySelector("#m4-margin-delta"),
      surcharge: root.querySelector("#m4-surcharge")
    };

    const calcMotor4 = () => {
      try {
        const result = computeMonitorCore({
          base: 75.28,
          current: Number.parseFloat(m4.slider?.value ?? ""),
          volume: Number.parseFloat(m4.volume?.value ?? ""),
          factor: Number.parseFloat(m4.factor?.value ?? ""),
          revenue: Number.parseFloat(m4.revenue?.value ?? ""),
          threshold: 50000
        });

        if (m4.display) m4.display.textContent = fmtEurDec.format(result.current) + " / tCO₂";
        if (m4.annual) m4.annual.textContent = (result.annualDelta >= 0 ? "+" : "−") + fmtEur.format(Math.abs(result.annualDelta));
        if (m4.pct) m4.pct.textContent = (result.pricePct >= 0 ? "+" : "") + fmtPct.format(result.pricePct) + "% Fiyat Hareketi";
        if (m4.weekly) m4.weekly.textContent = (result.weeklyDelta >= 0 ? "+" : "−") + fmtEur.format(Math.abs(result.weeklyDelta)) + " / hafta";
        if (m4.monthly) m4.monthly.textContent = (result.monthlyDelta >= 0 ? "+" : "−") + fmtEur.format(Math.abs(result.monthlyDelta)) + " / ay";
        if (m4.margin) m4.margin.textContent = (result.marginErosion >= 0 ? "−" : "+") + fmtPct.format(Math.abs(result.marginErosion)) + " Puan";
        if (m4.surcharge) m4.surcharge.textContent = (result.surcharge >= 0 ? "+" : "−") + fmtEurDec.format(Math.abs(result.surcharge)) + "/t";

        if (m4.card && m4.badge && m4.notice) {
          if (result.levelKey === "critical") {
            m4.card.className = "delta-hero-card critical-alert";
            m4.badge.textContent = "KRİTİK RİSK ALARMI";
            m4.notice.textContent = "Karbon fiyat değişimi yıllık bütçede " + fmtEur.format(result.annualDelta) + " ek sapma yaratıyor. Açık tekliflerde karbon geçiş payı değerlendirilmelidir.";
          } else if (result.levelKey === "elevated") {
            m4.card.className = "delta-hero-card elevated-alert";
            m4.badge.textContent = "DİKKAT: RİSK EŞİĞİ AŞILDI";
            m4.notice.textContent = "Karbon maliyeti tanımlı risk eşiğini aştı. Bütçe rezervi ve teklif fiyatı yeniden değerlendirilmelidir.";
          } else {
            m4.card.className = "delta-hero-card normal-alert";
            m4.badge.textContent = "BÜTÇE TOLERANSI İÇİNDE";
            m4.notice.textContent = "Fiyat hareketi tanımlı bütçe toleransı içinde.";
          }
        }
      } catch {
        if (m4.badge) m4.badge.textContent = "GEÇERSİZ VERİ";
        if (m4.notice) m4.notice.textContent = "Motor hatalı girdiyi sessizce düzeltmez.";
      }
    };

    [m4.slider, m4.volume, m4.factor, m4.revenue].forEach((el) => el?.addEventListener("input", calcMotor4));

    calcMotor2();
    calcMotor3();
    calcMotor4();
  }
</script>

