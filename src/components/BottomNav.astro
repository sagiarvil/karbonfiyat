---
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";

const navTabs = [
  {
    href: "/",
    label: "Ana Sayfa",
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>`
  },
  {
    href: "/karbon-fiyati",
    label: "Fiyatlar",
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>`
  },
  {
    href: "/karbon-maliyet-hesaplama",
    label: "Hesapla",
    badge: "Motor",
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="16" height="20" x="4" y="2" rx="2"/><line x1="8" x2="16" y1="6" y2="6"/><line x1="16" x2="16" y1="14" y2="18"/><path d="M16 10h.01"/><path d="M12 10h.01"/><path d="M8 10h.01"/><path d="M12 14h.01"/><path d="M8 14h.01"/><path d="M12 18h.01"/><path d="M8 18h.01"/></svg>`
  },
  {
    href: "/cbam-fiyati",
    label: "SKDM",
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/><path d="m9 12 2 2 4-4"/></svg>`
  },
  {
    href: "/#basvuru",
    label: "Ön Analiz",
    highlight: true,
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>`
  }
];
---

<nav class="mobile-bottom-nav" aria-label="Mobil Alt Hızlı Menü">
  <div class="bottom-nav-container">
    {navTabs.map((tab) => {
      const isActive = currentPath === tab.href || (tab.href !== "/" && currentPath.startsWith(tab.href));
      return (
        <a
          href={tab.href}
          class={`bottom-nav-item ${isActive ? "active" : ""} ${tab.highlight ? "highlight" : ""}`}
          aria-current={isActive ? "page" : undefined}
        >
          <div class="icon-wrap">
            <Fragment set:html={tab.icon} />
            {tab.badge && <span class="tab-badge">{tab.badge}</span>}
          </div>
          <span class="tab-label">{tab.label}</span>
        </a>
      );
    })}
  </div>
</nav>

<style>
  .mobile-bottom-nav {
    display: none;
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 999;
    background: rgba(10, 12, 15, 0.94);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-bottom: env(safe-area-inset-bottom, 0px);
    box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.5);
  }

  .bottom-nav-container {
    display: flex;
    align-items: center;
    justify-content: space-around;
    height: 64px;
    max-width: 600px;
    margin: 0 auto;
    padding: 0 4px;
  }

  .bottom-nav-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-width: 56px;
    min-height: 48px;
    height: 100%;
    color: #9AA1AC;
    text-decoration: none;
    gap: 3px;
    padding: 6px 4px;
    border-radius: 8px;
    transition: color 150ms ease, transform 150ms ease;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }

  .bottom-nav-item:hover,
  .bottom-nav-item:focus-visible {
    color: #FFFFFF;
  }

  .bottom-nav-item.active {
    color: #3B82F6;
  }

  .bottom-nav-item.highlight {
    color: #E8EAED;
  }

  .bottom-nav-item.highlight .icon-wrap {
    background: rgba(43, 92, 230, 0.18);
    border: 1px solid rgba(43, 92, 230, 0.4);
    color: #60A5FA;
    border-radius: 8px;
    padding: 2px 6px;
  }

  .icon-wrap {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 26px;
  }

  .tab-badge {
    position: absolute;
    top: -4px;
    right: -8px;
    font-size: 8px;
    font-weight: 700;
    line-height: 1;
    padding: 2px 4px;
    border-radius: 4px;
    background: #2563EB;
    color: #FFFFFF;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .tab-label {
    font-size: 11px;
    font-weight: 550;
    letter-spacing: -0.01em;
    line-height: 1.1;
  }

  .bottom-nav-item.active .tab-label {
    font-weight: 650;
  }

  @media (max-width: 880px) {
    .mobile-bottom-nav {
      display: block;
    }
  }
</style>
