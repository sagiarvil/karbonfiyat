---
interface Props {
  step: string;
  title: string;
  description: string;
  badge?: string;
}
const { step, title, description, badge } = Astro.props;
---
<article class="method-card card">
  <div class="method-head">
    <span class="step-label mono">{step}</span>
    {badge && <span class="chip">{badge}</span>}
  </div>
  <h3 class="method-title">{title}</h3>
  <p class="method-desc">{description}</p>
</article>

<style>
  .method-card {
    padding: 32px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 220px;
  }
  .method-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .step-label {
    font-size: 12px;
    color: var(--text-muted);
    font-weight: 650;
  }
  .method-title {
    font-size: 22px;
    color: var(--text-primary);
    margin: 20px 0 10px;
  }
  .method-desc {
    color: var(--text-secondary);
    font-size: 14px;
    line-height: 1.65;
    margin: 0;
  }
</style>
