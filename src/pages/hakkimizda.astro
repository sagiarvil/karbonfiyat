---
import Layout from "../layouts/Layout.astro";
import { seoPages } from "../data/seo";

const schema = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  url: "https://karbonfiyat.com/hakkimizda",
  name: "KarbonFiyat Hakkımızda",
  mainEntity: {
    "@type": "Organization",
    name: "KarbonFiyat",
    url: "https://karbonfiyat.com",
    logo: "https://karbonfiyat.com/logo/karbonfiyat-logo.png",
    founder: {
      "@type": "Person",
      name: "Barış Bağırlar",
      sameAs: ["https://www.linkedin.com/in/barisbagirlar/"]
    },
    email: "analiz@karbonfiyat.com",
    knowsAbout: ["CBAM", "EU ETS", "Türkiye ETS", "Karbon maliyeti", "Karbon finansal etkisi"],
    sameAs: [
      "https://www.wikidata.org/wiki/Q11589432",
      "https://x.com/karbonfiyat",
      "https://www.linkedin.com/company/karbonfiyat"
    ],
    relatedLink: [
      "https://skdmhesapla.com",
      "https://drfin.com.tr",
      "https://excelarsiv.com",
      "https://inversioncore.com",
      "https://degerlet.com",
      "https://dilekceyazdir.com.tr",
      "https://saatchi.com.tr",
      "https://belginkuyumculuk.com",
      "https://htmlandhtml.com"
    ]
  }
};
---
<Layout
  title={seoPages.hakkimizda.title}
  description={seoPages.hakkimizda.description}
  canonical={seoPages.hakkimizda.canonical}
  schema={schema}
>
  <section class="container trust-page">
    <span class="eyebrow">YAYINCI KİMLİĞİ</span>
    <h1>Karbon fiyatını finansal karara çevirmek için kuruldu.</h1>
    <p class="lead">
      KarbonFiyat; CBAM, EU ETS ve Türkiye ETS verilerini ürün maliyeti, brüt marj,
      müşteri kârlılığı ve fiyatlama kararına bağlayan hesaplama ve karar destek platformudur.
    </p>

    <div class="trust-grid">
      <article class="card trust-card">
        <h2>Ne yapıyoruz?</h2>
        <p>
          Resmî veri, piyasa verisi ve kullanıcı senaryosunu birbirinden ayırır;
          aynı girdilerle aynı sonucu üreten deterministik hesaplama motorları sunarız.
        </p>
      </article>
      <article class="card trust-card">
        <h2>Metodoloji sorumluluğu</h2>
        <p>
          Metodoloji mimarisi Barış Bağırlar tarafından yönetilir. Kullanılan kaynak,
          dönem, katsayı ve hesaplama mantığı mümkün olan her yerde görünür tutulur.
        </p>
        <a href="/metodoloji">Metodolojiyi inceleyin</a>
      </article>
      <article class="card trust-card">
        <h2>İletişim</h2>
        <p>Ön analiz, veri veya metodoloji soruları için kurumsal iletişim kanalı:</p>
        <a href="mailto:analiz@karbonfiyat.com">analiz@karbonfiyat.com</a>
      </article>
    </div>
  
    <div class="ecosystem-section" style="margin-top: 56px;">
      <span class="eyebrow">EKOSİSTEM PORTFÖYÜ</span>
      <h2 style="margin: 12px 0 16px; font-size: clamp(24px, 3.5vw, 36px); color: var(--text-primary);">10 Büyük Kurumsal Karar Verme ve Analiz Platformu Ağı</h2>
      <p style="max-width: 820px; color: var(--text-secondary); line-height: 1.7; margin-bottom: 28px;">
        KarbonFiyat, kurucumuz Barış Bağırlar tarafından geliştirilen ve yönetilen 10 büyük stratejik karar verme ve analiz platformunun karbon ve iklim finansmanı ayağını oluşturur:
      </p>
      <div class="ecosystem-grid">
        <a href="https://karbonfiyat.com" class="card eco-card">
          <h3>karbonfiyat.com</h3>
          <p>AB SKDM, EU ETS ve Türkiye ETS karbon finansmanı, ürün maliyeti ve kâr marjı karar motoru.</p>
        </a>
        <a href="https://skdmhesapla.com" target="_blank" rel="noopener" class="card eco-card">
          <h3>skdmhesapla.com ↗</h3>
          <p>AB Komisyonu CBAM Transition Registry uyumlu resmi XML beyanname ve gömülü emisyon hesaplama.</p>
        </a>
        <a href="https://degerlet.com" target="_blank" rel="noopener" class="card eco-card">
          <h3>degerlet.com ↗</h3>
          <p>Şirket değerleme, finansal çarpan analizi, DCF modelleme ve kurumsal değerleme hesaplama sistemi.</p>
        </a>
        <a href="https://excelarsiv.com" target="_blank" rel="noopener" class="card eco-card">
          <h3>excelarsiv.com ↗</h3>
          <p>Finans, muhasebe, sanayi ve operasyonel iş süreçleri için profesyonel Excel şablon ve model arşivi.</p>
        </a>
        <a href="https://inversioncore.com" target="_blank" rel="noopener" class="card eco-card">
          <h3>inversioncore.com ↗</h3>
          <p>İleri düzey sistem mimarisi, tersine mühendislik ilkeleri ve derin çekirdek yazılım teknolojileri.</p>
        </a>
        <a href="https://dilekceyazdir.com.tr" target="_blank" rel="noopener" class="card eco-card">
          <h3>dilekceyazdir.com.tr ↗</h3>
          <p>Adli, idari, tüketici ve kurumsal süreçler için yasal standartlara uygun otomatik dilekçe üretim platformu.</p>
        </a>
        <a href="https://saatchi.com.tr" target="_blank" rel="noopener" class="card eco-card">
          <h3>saatchi.com.tr ↗</h3>
          <p>Kurumsal marka stratejisi, yaratıcı tasarım mühendisliği ve dijital büyüme çözümleri.</p>
        </a>
        <a href="https://htmlandhtml.com" target="_blank" rel="noopener" class="card eco-card">
          <h3>htmlandhtml.com ↗</h3>
          <p>Semantik W3C web standartları, modern frontend mühendisliği ve dijital arayüz ekosistemi.</p>
        </a>
      </div>
    </div>

  </section>
</Layout>

<style>
  .trust-page { padding: 88px 0 36px; }
  .trust-page h1 {
    max-width: 860px;
    margin: 18px 0 16px;
    font-size: clamp(36px, 5vw, 58px);
    line-height: 1.06;
    color: var(--text-primary);
  }
  .trust-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-top: 40px;
  }
  .trust-card { padding: 28px; }
  .trust-card h2 {
    margin: 0 0 12px;
    font-size: 20px;
    color: var(--text-primary);
  }
  .trust-card p {
    margin: 0 0 14px;
    color: var(--text-secondary);
    line-height: 1.7;
  }
  .trust-card a { color: var(--text-primary); text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 860px) {
    .trust-page { padding-top: 56px; }
    .trust-grid { grid-template-columns: 1fr; }
  }

  .ecosystem-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  .eco-card {
    padding: 20px;
    text-decoration: none;
    transition: transform 180ms ease, border-color 180ms ease;
  }
  .eco-card:hover {
    transform: translateY(-2px);
    border-color: rgba(96, 165, 250, 0.4);
  }
  .eco-card h3 {
    margin: 0 0 8px;
    font-size: 16px;
    color: var(--text-primary);
  }
  .eco-card p {
    margin: 0;
    font-size: 13px;
    color: var(--text-secondary);
    line-height: 1.5;
  }
  @media (max-width: 1024px) {
    .ecosystem-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .ecosystem-grid { grid-template-columns: 1fr; }
  }

</style>
