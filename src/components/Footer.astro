---
import { footerColumns } from "../data/navigation";
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-col brand-col">
      <a class="footer-brand" href="/" aria-label="KarbonFiyat ana sayfa">
        <img src="/tulip-logo.png" alt="KarbonFiyat Logo" class="footer-logo-img" width="28" height="40" />
        <span>KarbonFiyat</span>
      </a>
      <p class="brand-desc">
        Karbon fiyatını finansal karara çeviren Carbon Financial Intelligence platformu.
      </p>
    </div>

    {footerColumns.map(col => (
      <div class="footer-col">
        <strong class="col-title">{col.title}</strong>
        <nav class="col-links" aria-label={col.title + " linkleri"}>
          {col.links.map(link => (
            <a href={link.href}>{link.label}</a>
          ))}
        </nav>
      </div>
    ))}
  </div>

  <div class="container footer-bottom">
    <span class="sub-copy mono">© {year} KarbonFiyat</span>
    <span class="sub-notice">
      Resmî, piyasa, tahmin ve kullanıcı senaryosu verileri ayrı statülerde gösterilir.
    </span>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border-soft);
    margin-top: 120px;
    padding: 64px 0 32px;
    background: #060707;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.35fr 1fr 1fr 1fr;
    gap: 36px;
  }
  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--text-primary);
    font-size: 21px;
    font-weight: 750;
    letter-spacing: -0.035em;
  }
  .footer-logo-img {
    height: 38px;
    width: auto;
    display: block;
    object-fit: contain;
    filter: drop-shadow(0 2px 10px rgba(216, 61, 42, 0.22));
    transition: transform 180ms cubic-bezier(.2,.8,.2,1);
  }
  .footer-brand:hover .footer-logo-img {
    transform: translateY(-1px) scale(1.04);
  }
  .brand-desc {
    color: var(--text-secondary);
    font-size: 14px;
    line-height: 1.6;
    margin: 0;
    max-width: 290px;
  }
  .col-title {
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-primary);
    font-weight: 650;
  }
  .col-links {
    display: flex;
    flex-direction: column;
    gap: 9px;
  }
  .col-links a {
    color: var(--text-secondary);
    font-size: 14px;
    transition: color 150ms ease;
  }
  .col-links a:hover {
    color: var(--text-primary);
  }
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    padding-top: 40px;
    margin-top: 48px;
    border-top: 1px solid var(--border-soft);
    font-size: 12px;
  }
  .sub-copy {
    font-size: 12px;
    color: var(--text-primary);
    font-weight: 550;
  }
  .sub-notice {
    color: var(--text-secondary);
  }

  @media (max-width: 860px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 32px;
    }
    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }
  }
  @media (max-width: 520px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>