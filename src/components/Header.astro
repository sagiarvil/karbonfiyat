---
import { navLinks } from "../data/navigation";
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const navItems = navLinks;
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="KarbonFiyat ana sayfa">
      <span class="brand-mark" aria-hidden="true">
        <img
          src="/logo/karbonfiyat-logo.png"
          alt=""
          class="brand-logo-img"
          width="44"
          height="44"
          loading="eager"
          decoding="async"
        />
      </span>
      <span class="brand-text">karbonfiyat</span>
    </a>

    <nav class="desktop-nav" aria-label="Ana menü">
      {navItems.map((item) => {
        const isActive = currentPath === item.href;
        const isExternal = item.href.startsWith("http");
        return (
          <a
            href={item.href}
            class={isActive ? "active" : ""}
            target={isExternal ? "_blank" : undefined}
            rel={isExternal ? "noopener" : undefined}
          >
            {item.label}
          </a>
        );
      })}
    </nav>

    <div class="header-actions">
      <a class="btn btn-secondary compact" href="/#huni">Hizmet Merdiveni</a>
      <a class="btn btn-primary compact" href="/#basvuru">4.900 TL Ön Analiz</a>
      <button class="mobile-toggle" id="menu-toggle" aria-label="Menüyü aç/kapat" aria-expanded="false">
        <span></span>
        <span></span>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" aria-hidden="true">
    <nav class="mobile-nav" aria-label="Mobil menü">
      {navItems.map((item) => {
        const isActive = currentPath === item.href;
        const isExternal = item.href.startsWith("http");
        return (
          <a
            href={item.href}
            class={isActive ? "active" : ""}
            target={isExternal ? "_blank" : undefined}
            rel={isExternal ? "noopener" : undefined}
          >
            {item.label}
          </a>
        );
      })}
    </nav>
    <div class="mobile-actions">
      <a class="btn btn-primary" href="/#basvuru">4.900 TL Ön Analiz</a>
      <a class="btn btn-secondary" href="/#huni">Hizmet Merdiveni</a>
    </div>
  </div>
</header>

<script is:inline>
  const toggleBtn = document.getElementById("menu-toggle");
  const mobileMenu = document.getElementById("mobile-menu");
  if (toggleBtn && mobileMenu) {
    toggleBtn.addEventListener("click", () => {
      const expanded = toggleBtn.getAttribute("aria-expanded") === "true";
      toggleBtn.setAttribute("aria-expanded", String(!expanded));
      mobileMenu.classList.toggle("open");
      mobileMenu.setAttribute("aria-hidden", String(expanded));
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: 72px;
    background: rgba(10, 12, 15, 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border-soft);
  }
  .header-inner {
    height: 72px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    font-weight: 750;
    font-size: 20px;
    letter-spacing: -0.035em;
    color: var(--text-primary);
    text-decoration: none;
    min-width: 0;
  }
  .brand-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    flex: 0 0 44px;
    line-height: 0;
  }
  .brand-logo-img {
    display: block;
    width: auto;
    height: 42px;
    max-width: 48px;
    object-fit: contain;
    flex: 0 0 auto;
    filter: none;
  }
  .brand-text {
    color: var(--text-primary);
    line-height: 1;
    white-space: nowrap;
  }
  .desktop-nav {
    display: flex;
    gap: 22px;
    font-size: 14px;
    font-weight: 500;
    white-space: nowrap;
  }
  .desktop-nav a {
    color: var(--text-secondary);
    padding: 6px 0;
    border-bottom: 1px solid transparent;
    transition: color 150ms ease, border-color 150ms ease;
  }
  .desktop-nav a:hover,
  .desktop-nav a.active {
    color: var(--text-primary);
    border-bottom: 1px solid var(--text-primary);
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .compact {
    min-height: 40px;
    padding: 0 16px;
    font-size: 13px;
    font-weight: 600;
  }
  .mobile-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    background: transparent;
    border: 1px solid var(--border-soft);
    border-radius: 8px;
    cursor: pointer;
    padding: 9px;
  }
  .mobile-toggle span {
    display: block;
    height: 2px;
    width: 100%;
    background: var(--text-primary);
    border-radius: 1px;
    transition: transform 150ms ease;
  }
  .mobile-menu {
    display: none;
    position: absolute;
    top: 72px;
    left: 0;
    right: 0;
    background: #0B0D0D;
    border-bottom: 1px solid var(--border-medium);
    padding: 24px;
    flex-direction: column;
    gap: 20px;
  }
  .mobile-menu.open {
    display: flex;
  }
  .mobile-nav {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .mobile-nav a {
    color: var(--text-secondary);
    font-size: 16px;
    font-weight: 500;
    padding: 8px 0;
    border-bottom: 1px solid var(--border-soft);
  }
  .mobile-nav a.active,
  .mobile-nav a:hover {
    color: var(--text-primary);
    border-bottom-color: var(--text-primary);
  }
  .mobile-actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-top: 10px;
  }

  @media (max-width: 1180px) {
    .header-inner { gap: 18px; }
    .desktop-nav { gap: 16px; font-size: 13px; }
    .header-actions .btn-secondary { display: none; }
  }

  @media (max-width: 960px) {
    .desktop-nav { display: none; }
    .mobile-toggle { display: flex; }
  }

  @media (max-width: 520px) {
    .header-actions .btn-primary { display: none; }

    .brand {
      gap: 10px;
      font-size: 18px;
    }

    .brand-mark {
      width: 36px;
      height: 36px;
      flex-basis: 36px;
    }

    .brand-logo-img {
      height: 36px;
      max-width: 40px;
    }
  }
</style>
